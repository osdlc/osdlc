<%
/*
 * Eta template for site reference/skills/<plugin>-<name>.md — one page per skill.
 *
 * Fed by regenSkills in site.ts via renderSiteTemplate("site_skill_template", data).
 * Data shape (it.*):
 *   pageTitle     string    e.g. "/sdlc:task-work"
 *   fmDescription string    first 200 chars of description, quotes escaped
 *   sourceRel     string    e.g. "solutions/ontological/plugin/plugins/sdlc/skills/task-work/task-work.md"
 *   description   string    full description text (empty string when absent)
 *   allowedTools  string[]  allowed-tools values (may be empty)
 *   body          string    skill body with leading H1 stripped, trimEnd() applied
 *
 * TypeScript owns data derivation; this template owns ALL layout.
 */
%>---
title: "<%~ it.pageTitle %>"
description: "<%~ it.fmDescription %>"
---

<!-- AUTO-GENERATED by `sdlc docs generate site` (solutions/ontological/lib/services/docs/site.ts) from <%~ it.sourceRel %>. Do not edit by hand. -->

_Generated from `<%~ it.sourceRel %>`._

<%~ it.description ? "## Description\n\n" + it.description + "\n\n" : "" %><%~ it.allowedTools.length ? "## Allowed tools\n\n" + it.allowedTools.map(function(t){ return "- `" + t + "`"; }).join("\n") + "\n\n" : "" %>## Source

<%~ it.body %>
