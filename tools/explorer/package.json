{
  "name": "@osdlc/markdown-explorer",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "An interactive graph of the osdlc markdown ecosystem, today and in the plan's target.",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --build && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --build",
    "test": "vitest run",
    "build-data": "node scripts/build-data.mjs"
  },
  "dependencies": {
    "@vue-flow/background": "1.3.2",
    "@vue-flow/controls": "1.1.3",
    "@vue-flow/core": "1.48.2",
    "@vue-flow/minimap": "1.5.4",
    "elkjs": "0.12.1",
    "vue": "3.5.45"
  },
  "devDependencies": {
    "@osdlc/corpus-schema": "workspace:*",
    "@types/node": "catalog:",
    "@vitejs/plugin-vue": "6.0.10",
    "@vue/tsconfig": "0.9.1",
    "typescript": "catalog:",
    "vite": "8.3.7",
    "vitest": "catalog:",
    "vue-tsc": "3.3.14",
    "yaml": "catalog:"
  }
}
