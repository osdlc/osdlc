{
  "name": "@osdlc/markdown-explorer",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "An interactive graph of the osdlc markdown ecosystem, today and in the plan's target.",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --build && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --build",
    "test": "vitest run",
    "sync-plan": "node scripts/sync-plan.mjs"
  },
  "dependencies": {
    "@vue-flow/background": "1.3.2",
    "@vue-flow/controls": "1.1.3",
    "@vue-flow/core": "1.48.2",
    "@vue-flow/minimap": "1.5.4",
    "elkjs": "0.12.1",
    "vue": "3.5.45"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@vitejs/plugin-vue": "6.0.10",
    "@vue/tsconfig": "0.9.1",
    "typescript": "6.0.3",
    "vite": "8.3.7",
    "vitest": "5.1.0",
    "vue-tsc": "3.3.14"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "vue-demi"
    ]
  }
}
