  "yaml": [
    {
      "name": "booleans, null, numbers and strings",
      "yaml": "a: true\nb: false\nc: null\nd: ~\ne: 1\nf: 1.5\ng: '1'\nh: text\ni: -3\n",
      "expected": {
        "a": true,
        "b": false,
        "c": null,
        "d": null,
        "e": 1,
        "f": 1.5,
        "g": "1",
        "h": "text",
        "i": -3
      }
    },
    {
      "name": "yes, no, on and off are strings",
      "yaml": "a: yes\nb: no\nc: on\nd: off\ne: Yes\nf: NO\ng: On\nh: OFF\n",
      "expected": {
        "a": "yes",
        "b": "no",
        "c": "on",
        "d": "off",
        "e": "Yes",
        "f": "NO",
        "g": "On",
        "h": "OFF"
      }
    },
    {
      "name": "infinity and not-a-number read as their text",
      "yaml": "a: .inf\nb: -.inf\nc: .nan\n",
      "expected": {
        "a": ".inf",
        "b": "-.inf",
        "c": ".nan"
      }
    },
    {
      "name": "a scalar key is a string",
      "yaml": "1: a\ntrue: b\n2.5: c\n",
      "expected": {
        "1": "a",
        "true": "b",
        "2.5": "c"
      }
    },
    {
      "name": "<< is an ordinary key",
      "yaml": "base: &b\n  x: 1\nderived:\n  <<: *b\n  y: 2\n",
      "expected": {
        "base": {
          "x": 1
        },
        "derived": {
          "<<": {
            "x": 1
          },
          "y": 2
        }
      }
    },
    {
      "name": "an alias to a scalar is that scalar",
      "yaml": "a: &x hello\nb: *x\n",
      "expected": {
        "a": "hello",
        "b": "hello"
      }
    },
    {
      "name": "a tag is dropped and the value kept",
      "yaml": "a: !!str 5\nb: !!int \"7\"\n",
      "expected": {
        "a": "5",
        "b": 7
      }
    },
    {
      "name": "nested mappings and sequences",
      "yaml": "a:\n  b:\n    - 1\n    - two\n    - c: 3\n",
      "expected": {
        "a": {
          "b": [
            1,
            "two",
            {
              "c": 3
            }
          ]
        }
      }
    },
    {
      "name": "a quoted number stays a string",
      "yaml": "a: '007'\nb: \"1e3\"\n",
      "expected": {
        "a": "007",
        "b": "1e3"
      }
    },
    {
      "name": "octal and hex integers",
      "yaml": "a: 0o17\nb: 0x1F\n",
      "expected": {
        "a": 15,
        "b": 31
      }
    },
    {
      "name": "a duplicate key is an error",
      "yaml": "a: 1\na: 2\n",
      "error": true
    },
    {
      "name": "a list key is an error",
      "yaml": "? [a]\n: x\n",
      "error": true
    },
    {
      "name": "a mapping key is an error",
      "yaml": "? {a: 1}\n: x\n",
      "error": true
    },
    {
      "name": "a null key is an error",
      "yaml": "~: x\n",
      "error": true
    },
    {
      "name": "a list at the top level is an error",
      "yaml": "- a\n- b\n",
      "error": true
    },
    {
      "name": "a scalar at the top level is an error",
      "yaml": "just text\n",
      "error": true
    },
    {
      "name": "an unclosed flow sequence is an error",
      "yaml": "a: [1, 2\n",
      "error": true
    }
  ],
  "resolve_config_path": [
    {
      "name": "a bare word passes through",
      "value": "dev",
      "base_dir": "/base",
      "home": "/home/me",
      "expected": "dev"
    },
    {
      "name": "a URL passes through",
      "value": "https://example.com/x",
      "base_dir": "/base",
      "home": "/home/me",
      "expected": "https://example.com/x"
    },
    {
      "name": "a git URL passes through",
      "value": "ssh://git@host/x.git",
      "base_dir": "/base",
      "home": "/home/me",
      "expected": "ssh://git@host/x.git"
    },
    {
      "name": "an absolute path stays",
      "value": "/a/b",
      "base_dir": "/base",
      "home": "/home/me",
      "expected": "/a/b"
    },
    {
      "name": "a relative path joins the base",
      "value": "sub/x",
      "base_dir": "/base",
      "home": "/home/me",
      "expected": "/base/sub/x"
    },
    {
      "name": "a dot path joins the base",
      "value": "./x",
      "base_dir": "/base",
      "home": "/home/me",
      "expected": "/base/x"
    },
    {
      "name": "a dot-dot path walks up from the base",
      "value": "../x",
      "base_dir": "/base/proj",
      "home": "/home/me",
      "expected": "/base/x"
    },
    {
      "name": "dot-dot inside a path is resolved",
      "value": "a/../b",
      "base_dir": "/base",
      "home": "/home/me",
      "expected": "/base/b"
    },
    {
      "name": "a dot file counts as a path",
      "value": ".config/x",
      "base_dir": "/base",
      "home": "/home/me",
      "expected": "/base/.config/x"
    },
    {
      "name": "tilde alone is the home",
      "value": "~",
      "base_dir": "/base",
      "home": "/home/me",
      "expected": "/home/me"
    },
    {
      "name": "tilde slash is under the home",
      "value": "~/x",
      "base_dir": "/base",
      "home": "/home/me",
      "expected": "/home/me/x"
    },
    {
      "name": "tilde slash with a nested path",
      "value": "~/a/b",
      "base_dir": "/base",
      "home": "/home/me",
      "expected": "/home/me/a/b"
    },
    {
      "name": "tilde user slash is not expanded",
      "value": "~user/x",
      "base_dir": "/base",
      "home": "/home/me",
      "expected": "/base/~user/x"
    },
    {
      "name": "tilde user alone is not expanded",
      "value": "~user",
      "base_dir": "/base",
      "home": "/home/me",
      "expected": "/base/~user"
    },
    {
      "name": "an empty home leaves tilde slash unexpanded",
      "value": "~/x",
      "base_dir": "/base",
      "home": "",
      "expected": "/base/~/x"
    },
    {
      "name": "an empty home leaves tilde alone unexpanded",
      "value": "~",
      "base_dir": "/base",
      "home": "",
      "expected": "/base/~"
    },
    {
      "name": "a relative home is used as given",
      "value": "~/x",
      "base_dir": "/base",
      "home": "rel",
      "expected": "/base/rel/x"
    }
  ],
  "substitute_path_names": [
    {
      "name": "no names in the value",
      "value": "/plain/path",
      "names": {
        "dev": "/home/me/dev",
        "work": "/work"
      },
      "setting": "repos:",
      "expected": "/plain/path"
    },
    {
      "name": "one name",
      "value": "{dev}/checkouts",
      "names": {
        "dev": "/home/me/dev",
        "work": "/work"
      },
      "setting": "repos:",
      "expected": "/home/me/dev/checkouts"
    },
    {
      "name": "two names",
      "value": "{dev}:{work}/x",
      "names": {
        "dev": "/home/me/dev",
        "work": "/work"
      },
      "setting": "repos:",
      "expected": "/home/me/dev:/work/x"
    },
    {
      "name": "the same name twice",
      "value": "{dev}/{dev}",
      "names": {
        "dev": "/home/me/dev",
        "work": "/work"
      },
      "setting": "repos:",
      "expected": "/home/me/dev//home/me/dev"
    },
    {
      "name": "a name in the middle",
      "value": "a/{work}/b",
      "names": {
        "dev": "/home/me/dev",
        "work": "/work"
      },
      "setting": "repos:",
      "expected": "a//work/b"
    },
    {
      "name": "an unknown name lists the available ones",
      "value": "{nope}/x",
      "names": {
        "dev": "/home/me/dev",
        "work": "/work"
      },
      "setting": "repos:",
      "error": "unknown path name '{nope}' in repos: '{nope}/x'; define it under paths: (available: {dev}, {work})"
    },
    {
      "name": "an unknown name after a known one",
      "value": "{dev}/{nope}",
      "names": {
        "dev": "/home/me/dev",
        "work": "/work"
      },
      "setting": "checkout.layout",
      "error": "unknown path name '{nope}' in checkout.layout '{dev}/{nope}'; define it under paths: (available: {dev}, {work})"
    },
    {
      "name": "an unknown name with no names defined",
      "value": "{nope}",
      "names": {},
      "setting": "repos:",
      "error": "unknown path name '{nope}' in repos: '{nope}'; define it under paths:"
    },
    {
      "name": "an unknown name with a define hint",
      "value": "{nope}",
      "names": {
        "dev": "/home/me/dev",
        "work": "/work"
      },
      "setting": "repos:",
      "define_hint": "add it to mytool.yaml",
      "error": "unknown path name '{nope}' in repos: '{nope}'; add it to mytool.yaml (available: {dev}, {work})"
    },
    {
      "name": "a known name with a define hint",
      "value": "{dev}",
      "names": {
        "dev": "/home/me/dev",
        "work": "/work"
      },
      "setting": "repos:",
      "define_hint": "add it to mytool.yaml",
      "expected": "/home/me/dev"
    },
    {
      "name": "an empty name is unknown",
      "value": "{}/x",
      "names": {
        "dev": "/home/me/dev",
        "work": "/work"
      },
      "setting": "repos:",
      "error": "unknown path name '{}' in repos: '{}/x'; define it under paths: (available: {dev}, {work})"
    }
  ],
  "needs": [
    {
      "name": "with a scaffold hint",
      "tool": "mytool",
      "project_file": "mytool.yaml",
      "machine_path": "/cfg/mytool/config.yaml",
      "scaffold_hint": "`mytool config scaffold` shows the full shape",
      "keys": [
        {
          "key": "authority",
          "scope": "project",
          "description": "The remote server the tool talks to."
        },
        {
          "key": "repos",
          "scope": "machine",
          "description": "Directories that hold checkouts."
        },
        {
          "key": "layout",
          "scope": "both",
          "description": "Where a checkout lands."
        }
      ],
      "cases": [
        {
          "name": "a project-only key, no project file, no command",
          "config": "authority",
          "command": [],
          "project_file_exists": false,
          "expected": "this command needs `authority`, and it is not set. The remote server the tool talks to. Set it in an mytool.yaml at the project root (none above {project_root}); `mytool config scaffold` shows the full shape."
        },
        {
          "name": "a project-only key, project file present",
          "config": "authority",
          "command": [],
          "project_file_exists": true,
          "expected": "this command needs `authority`, and it is not set. The remote server the tool talks to. Set it in {project_root}/mytool.yaml; `mytool config scaffold` shows the full shape."
        },
        {
          "name": "a machine-only key",
          "config": "repos",
          "command": [],
          "project_file_exists": false,
          "expected": "this command needs `repos`, and it is not set. Directories that hold checkouts. Set it in the machine config (/cfg/mytool/config.yaml); `mytool config scaffold` shows the full shape."
        },
        {
          "name": "a key in both files, no project file: the machine file leads",
          "config": "layout",
          "command": [],
          "project_file_exists": false,
          "expected": "this command needs `layout`, and it is not set. Where a checkout lands. Set it in the machine config (/cfg/mytool/config.yaml) or an mytool.yaml at the project root (none above {project_root}); `mytool config scaffold` shows the full shape."
        },
        {
          "name": "a key in both files, project file present: the project file leads",
          "config": "layout",
          "command": [],
          "project_file_exists": true,
          "expected": "this command needs `layout`, and it is not set. Where a checkout lands. Set it in {project_root}/mytool.yaml or the machine config (/cfg/mytool/config.yaml); `mytool config scaffold` shows the full shape."
        },
        {
          "name": "a command is named",
          "config": "repos",
          "command": [
            "push"
          ],
          "project_file_exists": false,
          "expected": "`mytool push` needs `repos`, and it is not set. Directories that hold checkouts. Set it in the machine config (/cfg/mytool/config.yaml); `mytool config scaffold` shows the full shape."
        },
        {
          "name": "two command words",
          "config": "repos",
          "command": [
            "upload",
            "run"
          ],
          "project_file_exists": false,
          "expected": "`mytool upload run` needs `repos`, and it is not set. Directories that hold checkouts. Set it in the machine config (/cfg/mytool/config.yaml); `mytool config scaffold` shows the full shape."
        },
        {
          "name": "a stand-in input is named as a flag",
          "config": "authority",
          "unless_input": "authority",
          "command": [],
          "project_file_exists": false,
          "expected": "this command needs `authority`, and it is not set (or pass --authority). The remote server the tool talks to. Set it in an mytool.yaml at the project root (none above {project_root}); `mytool config scaffold` shows the full shape."
        },
        {
          "name": "a camelCase stand-in input becomes a kebab-case flag",
          "config": "repos",
          "unless_input": "repoDir",
          "command": [],
          "project_file_exists": false,
          "expected": "this command needs `repos`, and it is not set (or pass --repo-dir). Directories that hold checkouts. Set it in the machine config (/cfg/mytool/config.yaml); `mytool config scaffold` shows the full shape."
        }
      ]
    },
    {
      "name": "without a scaffold hint",
      "tool": "mytool",
      "project_file": "mytool.yaml",
      "machine_path": "/cfg/mytool/config.yaml",
      "keys": [
        {
          "key": "authority",
          "scope": "project",
          "description": "The remote server the tool talks to."
        },
        {
          "key": "repos",
          "scope": "machine",
          "description": "Directories that hold checkouts."
        },
        {
          "key": "layout",
          "scope": "both",
          "description": "Where a checkout lands."
        }
      ],
      "cases": [
        {
          "name": "without a hint the message ends at the file",
          "config": "repos",
          "command": [],
          "project_file_exists": false,
          "expected": "this command needs `repos`, and it is not set. Directories that hold checkouts. Set it in the machine config (/cfg/mytool/config.yaml)."
