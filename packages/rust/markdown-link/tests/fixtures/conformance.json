  "parse": [
    {
      "name": "plain_target",
      "inner": "Note",
      "parsed": {
        "target": "Note",
        "heading": null,
        "alias": null,
        "targetAt": 0
      }
    },
    {
      "name": "heading_and_alias",
      "inner": "a#h|Alias",
      "parsed": {
        "target": "a",
        "heading": "h",
        "alias": "Alias",
        "targetAt": 0
      }
    },
    {
      "name": "whitespace_is_trimmed",
      "inner": " Note | a ",
      "parsed": {
        "target": "Note",
        "heading": null,
        "alias": "a",
        "targetAt": 1
      }
    },
    {
      "name": "escaped_pipe",
      "inner": "Note\\|a",
      "parsed": {
        "target": "Note",
        "heading": null,
        "alias": "a",
        "targetAt": 0
      }
    },
    {
      "name": "escaped_pipe_after_a_heading",
      "inner": "Note#H\\|a",
      "parsed": {
        "target": "Note",
        "heading": "H",
        "alias": "a",
        "targetAt": 0
      }
    },
    {
      "name": "only_one_backslash_is_the_escape",
      "inner": "Note\\\\|a",
      "parsed": {
        "target": "Note\\",
        "heading": null,
        "alias": "a",
        "targetAt": 0
      }
    },
    {
      "name": "backslash_without_a_pipe_stays",
      "inner": "Note\\",
      "parsed": {
        "target": "Note\\",
        "heading": null,
        "alias": null,
        "targetAt": 0
      }
    },
    {
      "name": "heading_keeps_later_hashes",
      "inner": "a#b#c",
      "parsed": {
        "target": "a",
        "heading": "b#c",
        "alias": null,
        "targetAt": 0
      }
    },
    {
      "name": "alias_keeps_later_pipes",
      "inner": "a|b|c",
      "parsed": {
        "target": "a",
        "heading": null,
        "alias": "b|c",
        "targetAt": 0
      }
    },
    {
      "name": "hash_in_the_alias_is_not_a_heading",
      "inner": "a#b|c#d",
      "parsed": {
        "target": "a",
        "heading": "b",
        "alias": "c#d",
        "targetAt": 0
      }
    },
    {
      "name": "block_reference_is_a_heading",
