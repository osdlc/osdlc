      "parsed": null
    },
    {
      "name": "escaped_pipe_only_has_no_target",
      "inner": "\\|a",
      "parsed": null
    },
    {
      "name": "blank_has_no_target",
      "inner": " ",
      "parsed": null
    },
    {
      "name": "alias_only_has_no_target",
      "inner": "|alias",
      "parsed": null
    },
    {
      "name": "unicode_whitespace_is_trimmed",
