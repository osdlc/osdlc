  "env_cases": [
    {
      "name": "EXAMPLE_ROOT alone moves all seven",
      "env": {
        "EXAMPLE_ROOT": "/fr"
      },
      "expected": {
        "durable": "/fr/durable",
        "config": "/fr/config",
        "cache": "/fr/cache",
        "state": "/fr/state",
        "logs": "/fr/logs",
        "runtime": "/fr/durable/run",
        "scratch": "/fr/scratch"
      }
    },
    {
      "name": "a tier var beats EXAMPLE_ROOT for its own home",
      "env": {
        "EXAMPLE_ROOT": "/fr",
        "EXAMPLE_CACHE_DIR": "/warm"
      },
      "expected": {
        "durable": "/fr/durable",
        "config": "/fr/config",
        "cache": "/warm",
        "state": "/fr/state",
        "logs": "/fr/logs",
        "runtime": "/fr/durable/run",
        "scratch": "/fr/scratch"
      }
    },
    {
      "name": "a tier var alone moves only its home",
      "env": {
        "EXAMPLE_SCRATCH_DIR": "/s"
      },
      "expected": {
        "scratch": "/s"
      }
    },
    {
      "name": "durable alone carries runtime to <durable>/run",
      "env": {
        "EXAMPLE_DURABLE_DIR": "/d"
      },
      "expected": {
        "durable": "/d",
        "runtime": "/d/run"
      }
    },
    {
      "name": "an overridden durable carries runtime out of EXAMPLE_ROOT",
      "env": {
        "EXAMPLE_ROOT": "/fr",
        "EXAMPLE_DURABLE_DIR": "/d"
      },
      "expected": {
        "durable": "/d",
        "config": "/fr/config",
        "cache": "/fr/cache",
        "state": "/fr/state",
        "logs": "/fr/logs",
        "runtime": "/d/run",
        "scratch": "/fr/scratch"
      }
    },
    {
      "name": "every tier var set",
      "env": {
        "EXAMPLE_DURABLE_DIR": "/t/d",
        "EXAMPLE_CONFIG_DIR": "/t/c",
        "EXAMPLE_CACHE_DIR": "/t/k",
        "EXAMPLE_STATE_DIR": "/t/st",
        "EXAMPLE_LOGS_DIR": "/t/l",
        "EXAMPLE_RUNTIME_DIR": "/t/r",
        "EXAMPLE_SCRATCH_DIR": "/t/s"
      },
      "expected": {
        "durable": "/t/d",
        "config": "/t/c",
        "cache": "/t/k",
        "state": "/t/st",
        "logs": "/t/l",
        "runtime": "/t/r",
        "scratch": "/t/s"
      }
    },
    {
      "name": "EXAMPLE_STATE_DIR moves only state",
      "env": {
        "EXAMPLE_STATE_DIR": "/st"
      },
      "expected": {
        "state": "/st"
      }
    },
    {
      "name": "EXAMPLE_CONVENTION=xdg selects the XDG table",
      "env": {
        "EXAMPLE_CONVENTION": "xdg",
        "XDG_DATA_HOME": "/x/d",
        "XDG_CONFIG_HOME": "/x/c",
        "XDG_CACHE_HOME": "/x/k",
        "XDG_STATE_HOME": "/x/s",
        "XDG_RUNTIME_DIR": "/run/u/1"
      },
      "expected": {
        "durable": "/x/d",
        "config": "/x/c",
        "cache": "/x/k",
        "state": "/x/s",
        "logs": "/x/s",
        "runtime": "/run/u/1"
      },
      "windows_native": true
    },
    {
      "name": "EXAMPLE_CONVENTION is trimmed",
      "env": {
        "EXAMPLE_CONVENTION": " xdg ",
        "XDG_DATA_HOME": "/x/d",
        "XDG_CONFIG_HOME": "/x/c",
        "XDG_CACHE_HOME": "/x/k",
        "XDG_STATE_HOME": "/x/s",
        "XDG_RUNTIME_DIR": "/run/u/1"
      },
      "expected": {
        "durable": "/x/d",
        "config": "/x/c",
        "cache": "/x/k",
        "state": "/x/s",
        "logs": "/x/s",
        "runtime": "/run/u/1"
      },
      "windows_native": true
    },
    {
      "name": "the constructor's xdg selects the XDG table",
      "convention": "xdg",
      "env": {
        "XDG_DATA_HOME": "/x/d",
        "XDG_CONFIG_HOME": "/x/c",
        "XDG_CACHE_HOME": "/x/k",
        "XDG_STATE_HOME": "/x/s",
        "XDG_RUNTIME_DIR": "/run/u/1"
      },
      "expected": {
        "durable": "/x/d",
        "config": "/x/c",
        "cache": "/x/k",
        "state": "/x/s",
        "logs": "/x/s",
        "runtime": "/run/u/1"
      },
      "windows_native": true
    },
    {
      "name": "EXAMPLE_CONVENTION=native beats the constructor's xdg",
      "convention": "xdg",
      "env": {
        "EXAMPLE_CONVENTION": "native"
      },
      "expected": {}
    },
    {
      "name": "EXAMPLE_ROOT beats xdg",
      "env": {
        "EXAMPLE_CONVENTION": "xdg",
        "EXAMPLE_ROOT": "/fr",
        "XDG_DATA_HOME": "/x/d",
        "XDG_CONFIG_HOME": "/x/c",
        "XDG_CACHE_HOME": "/x/k",
        "XDG_STATE_HOME": "/x/s",
        "XDG_RUNTIME_DIR": "/run/u/1"
      },
      "expected": {
        "durable": "/fr/durable",
        "config": "/fr/config",
        "cache": "/fr/cache",
        "state": "/fr/state",
        "logs": "/fr/logs",
        "runtime": "/fr/durable/run",
        "scratch": "/fr/scratch"
      }
    },
    {
      "name": "EXAMPLE_CONFIG_DIR beats XDG_CONFIG_HOME",
      "env": {
        "EXAMPLE_CONVENTION": "xdg",
        "XDG_CONFIG_HOME": "/x/c",
        "EXAMPLE_CONFIG_DIR": "/ec"
      },
      "expected": {
        "config": "/ec"
      }
    },
    {
      "name": "under xdg EXAMPLE_STATE_DIR moves state and leaves logs",
      "env": {
        "EXAMPLE_CONVENTION": "xdg",
        "XDG_STATE_HOME": "/x/s",
        "EXAMPLE_STATE_DIR": "/st"
      },
      "expected": {
        "state": "/st"
      }
    },
    {
      "name": "nothing set is the OS default",
      "env": {},
      "expected": {}
    }
  ],
