  "env_cases": [
    {
      "name": "EXAMPLE_ROOT alone moves all six",
      "env": {
        "EXAMPLE_ROOT": "/fr"
      },
      "expected": {
        "durable": "/fr/durable",
        "config": "/fr/config",
        "cache": "/fr/cache",
        "logs": "/fr/logs",
        "runtime": "/fr/durable/run",
        "scratch": "/fr/scratch"
      }
    },
    {
      "name": "a tier var beats EXAMPLE_ROOT for its own home",
      "env": {
        "EXAMPLE_ROOT": "/fr",
        "EXAMPLE_CACHE_DIR": "/warm"
      },
      "expected": {
        "durable": "/fr/durable",
        "config": "/fr/config",
        "cache": "/warm",
        "logs": "/fr/logs",
        "runtime": "/fr/durable/run",
        "scratch": "/fr/scratch"
      }
    },
    {
      "name": "a tier var alone moves only its home",
      "env": {
        "EXAMPLE_SCRATCH_DIR": "/s"
      },
      "expected": {
        "scratch": "/s"
      }
    },
    {
      "name": "durable alone carries runtime to <durable>/run",
      "env": {
        "EXAMPLE_DURABLE_DIR": "/d"
      },
      "expected": {
        "durable": "/d",
        "runtime": "/d/run"
      }
    },
    {
      "name": "an overridden durable carries runtime out of EXAMPLE_ROOT",
      "env": {
        "EXAMPLE_ROOT": "/fr",
        "EXAMPLE_DURABLE_DIR": "/d"
      },
      "expected": {
        "durable": "/d",
        "config": "/fr/config",
        "cache": "/fr/cache",
        "logs": "/fr/logs",
        "runtime": "/d/run",
        "scratch": "/fr/scratch"
      }
    },
    {
      "name": "every tier var set",
      "env": {
        "EXAMPLE_DURABLE_DIR": "/t/d",
        "EXAMPLE_CONFIG_DIR": "/t/c",
        "EXAMPLE_CACHE_DIR": "/t/k",
        "EXAMPLE_LOGS_DIR": "/t/l",
        "EXAMPLE_RUNTIME_DIR": "/t/r",
        "EXAMPLE_SCRATCH_DIR": "/t/s"
      },
      "expected": {
        "durable": "/t/d",
        "config": "/t/c",
        "cache": "/t/k",
        "logs": "/t/l",
        "runtime": "/t/r",
        "scratch": "/t/s"
      }
    },
    {
      "name": "nothing set is the OS default",
      "env": {},
      "expected": {}
    }
