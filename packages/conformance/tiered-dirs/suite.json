            "tier": "suite",
            "key": "notes",
            "home": "logs",
            "scope_kind": null,
            "scope_key": null,
            "app": "server"
          },
          "expect": {
            "relative": "com.example.notes/server"
          }
        },
        {
          "name": "suite scope, no app",
          "input": {
