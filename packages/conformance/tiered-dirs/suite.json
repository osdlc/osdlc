{
  "family": "tiered-dirs",
  "reference": "ts",
  "referenceVersion": "0.5.0",
  "sections": {
    "resolve": {
      "description": "Resolve a directory: a tier (with its key), a home, then the optional scope and app narrowing, under base directories stubbed with the rooted layout at /stub. `relative` is the path below the home's base directory, /-separated.",
      "cases": [
        {
          "name": "vendor durable",
          "input": {
            "vendor": "com.example",
            "tier": "vendor",
            "key": null,
            "home": "durable",
            "scope_kind": null,
            "scope_key": null,
            "app": null
          },
          "expect": {
            "relative": "com.example"
          }
        },
        {
          "name": "vendor config",
          "input": {
            "vendor": "com.example",
            "tier": "vendor",
            "key": null,
            "home": "config",
