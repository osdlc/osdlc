{
  // Emit config for the published dist/ — the dev tsconfig.json stays noEmit.
  // Sources only, and no Bun types, so a Bun global in a source fails the build.
  "extends": ["./tsconfig.json", "@sksizer/tsconfig/build"],
  "compilerOptions": {
    "rootDir": ".",
    "types": ["node"]
  },
  "include": ["*.ts"]
}
