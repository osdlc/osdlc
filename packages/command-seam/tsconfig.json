{
  // Typechecks the sources, tests/ and examples/. The build has its own include.
  "extends": "@sksizer/tsconfig/bun-lib",
  "compilerOptions": {
    // Resolve `@sksizer/command-seam` in examples/ to the sources, as bun does.
    "customConditions": ["bun"]
  },
  "include": ["*.ts", "tests/**/*.ts", "examples/**/*.ts"]
}
