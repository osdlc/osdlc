{
  // The emit block, as a MIXIN. Use it as the LAST element of an extends array,
  // never on its own:
  //
  //   "extends": ["./tsconfig.json", "@osdlc/tsconfig/build"]
  //
  // Two things here are deliberate, and both fail silently if changed.
  //
  // 1. `${configDir}` on outDir. A file-path option in an extended config is
  //    normalized against THAT CONFIG'S directory, not the consumer's — a plain
  //    "dist" here emits into this package's own directory, so every consumer's
  //    build produces nothing and the npm tarballs ship empty. The template is
  //    exempted from that normalization and substitutes against the consuming
  //    project. (typescript 6.0.3, normalizeNonListOptionValue.)
  //
  // 2. No `extends`, and no `include`/`exclude`/`files`. Extending a preset here
  //    would re-apply it over the consumer's own config and revert what the
  //    consumer overrode — a NodeNext package would silently become
  //    ESNext/Bundler. An `include` here would replace the consumer's, rebased
  //    onto a directory inside node_modules.
  //
  // `rootDir` is not here either: it differs between consumers ("." or "src"),
  // and guessing wrong quietly changes the dist/ layout.
  "compilerOptions": {
    "noEmit": false,
    "outDir": "${configDir}/dist",
    "declaration": true,
    "declarationMap": true,
    // What makes an emitting build legal alongside source-shipped.json's
    // `allowImportingTsExtensions`, which TS otherwise rejects (TS5096); also
    // what lets a source-shipped dependency whose own imports carry .ts
    // extensions typecheck through (TS5097).
    "rewriteRelativeImportExtensions": true
  }
}
