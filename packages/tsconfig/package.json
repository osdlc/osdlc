{
  "name": "@sksizer/tsconfig",
  "version": "0.3.0",
  "description": "Strict TypeScript compiler presets: a shared bar plus node, bun, vue and build shapes. Consumed through `extends`; ships no code.",
  "license": "MIT",
  "author": "SK Sizer",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sksizer/sdlc.git",
    "directory": "packages/tsconfig"
  },
  "homepage": "https://github.com/sksizer/sdlc/tree/main/packages/tsconfig#readme",
  "bugs": "https://github.com/sksizer/sdlc/issues",
  "keywords": [
    "tsconfig",
    "typescript",
    "preset",
    "strict"
  ],
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "presets/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "exports": {
    "./base": "./presets/base.json",
    "./base.json": "./presets/base.json",
    "./source-shipped": "./presets/source-shipped.json",
    "./source-shipped.json": "./presets/source-shipped.json",
    "./node-lib": "./presets/node-lib.json",
    "./node-lib.json": "./presets/node-lib.json",
    "./bun-lib": "./presets/bun-lib.json",
    "./bun-lib.json": "./presets/bun-lib.json",
    "./vue": "./presets/vue.json",
    "./vue.json": "./presets/vue.json",
    "./build": "./presets/build.json",
    "./build.json": "./presets/build.json",
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tests/resolve.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "oxlint ."
  },
  "devDependencies": {
    "@sksizer/prettier-config": "workspace:^",
    "oxlint": "^1.65.0",
    "prettier": "3.9.6",
    "typescript": "~6.0.3"
  }
}
