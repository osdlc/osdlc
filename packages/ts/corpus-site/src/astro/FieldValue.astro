---
// One value of a record, drawn from its display tree. Props: `value`, a Display.
const { value } = Astro.props
const inline = (items) => items.every((item) => item.kind === 'badge')
const blocks = (items) => items.some((item) => item.kind === 'object')
---

{value.kind === 'text' && (value.code ? <code>{value.text}</code> : <span>{value.text}</span>)}
{value.kind === 'link' && <a href={value.href} rel={value.external ? 'noopener' : undefined}>{value.text}</a>}
{value.kind === 'missing' && <span class="cs-missing" title={value.reason ?? 'This names no record'}>{value.text}</span>}
{value.kind === 'badge' && <span class="cs-badge" data-color={value.color} title={value.description ?? undefined}>{value.text}</span>}
{value.kind === 'date' && <time datetime={value.iso}>{value.text}</time>}
{
  value.kind === 'list' && (
    <ul class="cs-list" data-inline={inline(value.items) ? '' : undefined} data-blocks={blocks(value.items) ? '' : undefined}>
      {value.items.map((item) => <li><Astro.self value={item} /></li>)}
    </ul>
  )
}
{
  value.kind === 'object' && (
    <dl class="cs-object">
      {value.entries.map((entry) => (
        <>
          <dt title={entry.help ?? undefined}>{entry.label}</dt>
          <dd>{entry.value.kind === 'empty' ? <span class="cs-empty">–</span> : <Astro.self value={entry.value} />}</dd>
        </>
      ))}
    </dl>
  )
}
