{
  // Typechecks the source and tests. The build has its own include.
  // Workspace siblings resolve through `exports` to their built `dist/`, so
  // run the build before the typecheck.
  "extends": "@osdlc/tsconfig/node-lib",
  "compilerOptions": {
    // The podman example is a package of its own, where this package's name
    // does not resolve. It gets the built dist/ that `exports` names, as the
    // other examples do.
    "paths": {
      "@osdlc/host-cleaner": ["./dist/index.d.ts"],
      "@osdlc/host-cleaner/plugin": ["./dist/plugin.d.ts"],
      "@osdlc/host-cleaner/testing": ["./dist/testing.d.ts"]
    }
  },
  "include": ["src", "tests", "examples", "vitest.config.ts"]
}
