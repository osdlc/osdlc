{
  "name": "@osdlc/markdown-render-vue",
  "version": "0.7.0",
  "description": "Vue 3 components for @osdlc/markdown-render: a MarkdownRender component that walks the rendered hast into VNodes (never v-html), with built-in wikilink, tag, embed, callout, task, math, mermaid, code and table components and an injected NoteSource.",
  "license": "MIT OR Apache-2.0",
  "author": "sksizer",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/osdlc/osdlc.git",
    "directory": "packages/ts/markdown-render-vue"
  },
  "homepage": "https://github.com/osdlc/osdlc/tree/main/packages/ts/markdown-render-vue#readme",
  "bugs": "https://github.com/osdlc/osdlc/issues",
  "keywords": [
    "markdown",
    "obsidian",
    "wikilink",
    "vue",
    "vue3",
    "components",
    "renderer",
    "typescript"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE-MIT",
    "LICENSE-APACHE",
    "SECURITY.md",
    "CONTRIBUTING.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "smoke": "node tests/smoke.mjs",
    "prepublishOnly": "npm run clean && npm run build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "oxlint .",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.build.json --noEmit"
  },
  "dependencies": {
    "@osdlc/gfm-table": "workspace:^",
    "@osdlc/markdown-render": "workspace:^",
    "@types/hast": "^3.0.4",
    "@types/unist": "^3.0.3"
  },
  "peerDependencies": {
    "katex": "^0.19.1",
    "mermaid": "^11.12.2",
    "vue": "^3.5"
  },
  "peerDependenciesMeta": {
    "katex": {
      "optional": true
    },
    "mermaid": {
      "optional": true
    }
  },
  "devDependencies": {
    "@osdlc/prettier-config": "workspace:^",
    "@osdlc/tsconfig": "workspace:^",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "jsdom": "^26.0.0",
    "katex": "^0.19.1",
    "mermaid": "^11.12.2",
    "oxlint": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "vue": "^3.5.25"
  }
}
