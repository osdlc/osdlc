{
  "name": "@osdlc/trust-repo",
  "version": "0.2.1",
  "description": "Per-repository consent to run a repository's own scripts: a marker store remembered across runs, an exec gate, and a path and owner policy over it.",
  "license": "MIT OR Apache-2.0",
  "author": "sksizer",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/osdlc/osdlc.git",
    "directory": "packages/ts/trust-repo"
  },
  "homepage": "https://github.com/osdlc/osdlc/tree/main/packages/ts/trust-repo#readme",
  "bugs": "https://github.com/osdlc/osdlc/issues",
  "keywords": [
    "trust",
    "consent",
    "cli",
    "xdg",
    "exec-gate"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE-MIT",
    "LICENSE-APACHE",
    "SECURITY.md",
    "CONTRIBUTING.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "test": "vitest run",
    "smoke": "node tests/smoke.mjs",
    "coverage": "vitest run --coverage",
    "prepublishOnly": "npm run clean && npm run build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "oxlint .",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.build.json --noEmit"
  },
  "dependencies": {
    "@osdlc/etag-write": "workspace:^",
    "@osdlc/path-guard": "workspace:^"
  },
  "devDependencies": {
    "@osdlc/prettier-config": "workspace:^",
    "@osdlc/tsconfig": "workspace:^",
    "@types/node": "^26.1.0",
    "@vitest/coverage-v8": "^5.0.5",
    "oxlint": "^1.65.0",
    "prettier": "3.9.6",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  }
}
