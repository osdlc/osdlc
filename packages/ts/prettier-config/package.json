{
  "name": "@osdlc/prettier-config",
  "version": "0.3.0",
  "description": "A shared Prettier config: no semicolons, single quotes, trailing commas, 100 columns. Markdown is left alone.",
  "license": "MIT OR Apache-2.0",
  "author": "SK Sizer",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/osdlc/osdlc.git",
    "directory": "packages/ts/prettier-config"
  },
  "homepage": "https://github.com/osdlc/osdlc/tree/main/packages/ts/prettier-config#readme",
  "bugs": "https://github.com/osdlc/osdlc/issues",
  "keywords": [
    "prettier",
    "prettier-config"
  ],
  "publishConfig": {
    "access": "public"
  },
  "main": "index.json",
  "files": [
    "index.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE-MIT",
    "LICENSE-APACHE"
  ],
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "oxlint . --no-error-on-unmatched-pattern"
  },
  "devDependencies": {
    "oxlint": "^1.65.0",
    "prettier": "3.9.6"
  }
}
