{
  "name": "@osdlc/typed-git",
  "version": "0.12.0",
  "description": "A typed git client for TypeScript, sync and awaitable. Each verb declares what absence means for it; every other failure throws. git.try.* inspects, raw() bypasses \u2014 over an injectable backend that drives the git CLI or any other implementation.",
  "license": "MIT OR Apache-2.0",
  "author": "sksizer",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/osdlc/osdlc.git",
    "directory": "packages/ts/typed-git"
  },
  "homepage": "https://github.com/osdlc/osdlc/tree/main/packages/ts/typed-git#readme",
  "bugs": "https://github.com/osdlc/osdlc/issues",
  "keywords": [
    "git",
    "git-client",
    "worktree",
    "typescript",
    "cli-wrapper",
    "dependency-injection"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    }
  },
  "files": [
    "dist/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE-MIT",
    "LICENSE-APACHE",
    "SECURITY.md",
    "CONTRIBUTING.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "test": "vitest run",
    "smoke": "node tests/smoke.mjs",
    "prepublishOnly": "npm run clean && npm run build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "oxlint .",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.build.json --noEmit",
    "typecheck:ts59": "node node_modules/typescript59/bin/tsc -p tsconfig.build.json --noEmit",
    "check:extra": "pnpm run typecheck:ts59",
    "coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@osdlc/command-seam": "workspace:^",
    "hosted-git-info": "^10.1.1",
    "@osdlc/result": "workspace:^"
  },
  "devDependencies": {
    "@osdlc/prettier-config": "workspace:^",
    "@osdlc/tsconfig": "workspace:^",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "oxlint": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:",
    "typescript59": "npm:typescript@5.9.3",
    "vitest": "catalog:"
  }
}
