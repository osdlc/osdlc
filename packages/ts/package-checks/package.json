{
  "name": "@osdlc/package-checks",
  "version": "0.0.0",
  "description": "Checks for a repository of TypeScript and Rust packages: package shape, the packed tarball in a clean consumer, breaking changes and crate versions, the packages a pull request affects, and staging a new package on npm. A library and a `package-checks` command.",
  "license": "MIT OR Apache-2.0",
  "author": "sksizer",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/osdlc/osdlc.git",
    "directory": "packages/ts/package-checks"
  },
  "homepage": "https://github.com/osdlc/osdlc/tree/main/packages/ts/package-checks#readme",
  "bugs": "https://github.com/osdlc/osdlc/issues",
  "keywords": [
    "package-shape",
    "publint",
    "arethetypeswrong",
    "monorepo",
    "pnpm",
    "cargo",
    "semver",
    "ci",
    "npm",
    "trusted-publishing"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "package-checks": "./bin/package-checks.js"
  },
  "files": [
    "dist/",
    "bin/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE-MIT",
    "LICENSE-APACHE",
    "SECURITY.md",
    "CONTRIBUTING.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "test": "vitest run",
    "smoke": "node tests/smoke.mjs",
    "coverage": "vitest run --coverage",
    "prepublishOnly": "npm run clean && npm run build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "oxlint .",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.build.json --noEmit"
  },
  "dependencies": {
    "@arethetypeswrong/cli": "catalog:",
    "@osdlc/command-seam": "workspace:^",
    "publint": "catalog:",
    "semver": "catalog:",
    "smol-toml": "catalog:"
  },
  "devDependencies": {
    "@osdlc/prettier-config": "workspace:^",
    "@osdlc/tsconfig": "workspace:^",
    "@types/node": "catalog:",
    "@types/semver": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "oxlint": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
