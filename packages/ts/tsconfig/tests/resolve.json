{
  // Resolution probe. The `typecheck` script points tsc at this file.
  //
  // It extends every preset by the bare specifier a consumer writes, so tsc
  // must resolve each one through this package's `exports` map. This catches a
  // mistake that nothing inside the package shows: a preset file added without
  // its `exports` entry, which breaks every consumer.
  //
  // The array form also tests the left-to-right merge that tsconfig.build.json
  // files depend on. `--noEmit` on the command line overrides build.json's
  // `noEmit: false`.
  "extends": [
    "@osdlc/tsconfig/base",
    "@osdlc/tsconfig/source-shipped",
    "@osdlc/tsconfig/node-lib",
    "@osdlc/tsconfig/bun-lib",
    "@osdlc/tsconfig/vue",
    "@osdlc/tsconfig/build"
  ],
  "include": ["probe.ts"]
}
