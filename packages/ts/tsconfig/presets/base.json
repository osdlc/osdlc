{
  // The strictness bar every package on these presets meets. It is the only
  // preset that assumes nothing about how a package is shipped.
  //
  // A shared bar means strictness is not chosen per package. A package cannot
  // be laxer than the app that consumes it, and a new package inherits the bar.
  //
  // Nothing here assumes a workspace, a bundler or source-shipped siblings, so
  // this is the preset an outside consumer extends. The two options that do
  // assume them, `allowImportingTsExtensions` and `noEmit`, are in
  // ./source-shipped.json, which the other presets extend. No package in this
  // repo extends this file directly. The resolution probe in tests/ checks it.
  //
  // `lib`, `types`, `jsx` and `include` are left out on purpose. They differ
  // between packages (a DOM library and a node CLI), so each package sets them.
  // The combinations that recur are the other presets: ./node-lib.json,
  // ./bun-lib.json and ./vue.json. A package that fits none of them extends
  // ./source-shipped.json and states its own options. A preset with only two
  // users would hide one clear line behind an extra file.
  //
  // Do not use this bar under a config that extends a framework-generated one
  // (./.nuxt/tsconfig.json, astro/tsconfigs/*). It would overwrite the `paths`,
  // `types`, `moduleResolution` and `jsx` the generator computed.
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    // Capitalised. TypeScript accepts either spelling, so packages drift apart
    // unless one is fixed here.
    "moduleResolution": "Bundler",

    "strict": true,
    // `arr[i]` is `T | undefined`. Without this, an index out of range is a
    // runtime error instead of a compile error.
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,

    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "skipLibCheck": true,

    // An optional property is either absent or holds a value. It is not
    // "present and undefined". Most fixes omit the key rather than widen the
    // type to `T | undefined`.
    "exactOptionalPropertyTypes": true
  }
}
