{
  // A node library whose tests or runtime use Bun: node globals plus bun's.
  //
  // It adds only `types`. `customConditions: ["bun"]` is not set here, because
  // packages of this kind differ on it. Each package sets it itself.
  //
  // That setting decides whether a workspace sibling resolves to its
  // TypeScript source or to its published `dist/`. A wrong value breaks the
  // build. A package that imports a source-shipped sibling typechecks that
  // sibling's source under its own options. If the sibling imports a package
  // whose `types` point at a `dist/` that no typecheck builds, the import fails
  // with TS2307, even though the sibling's own check passes. The error shows
  // only when the importing package is next checked, which may be much later.
  //
  // So a package that imports a source-shipped sibling must use that sibling's
  // condition. The other option is to build the dependency first, which needs
  // a build task that a source-shipped package may not have.
  "extends": "./node-lib.json",
  "compilerOptions": {
    "types": ["node", "bun"]
  }
}
