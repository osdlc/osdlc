{
  // A Vue 3 component package: a modern browser target, the DOM and its
  // iterable collections, SFC/JSX left to the bundler, and no ambient @types.
  // A browser component must not pick up node globals. An omitted `types`
  // includes them as soon as anything hoists @types/node into node_modules.
  //
  // A Vue package that targets ES2022, or sets no `jsx`, does not fit this
  // preset. It extends ./source-shipped.json directly and sets its own options.
  "extends": "./source-shipped.json",
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "jsx": "preserve",
    "types": []
  }
}
