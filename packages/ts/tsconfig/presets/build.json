{
  // The emit options, as a mixin. Use it as the last element of an extends
  // array, never on its own:
  //
  //   "extends": ["./tsconfig.json", "@osdlc/tsconfig/build"]
  //
  // Two choices here are deliberate. Changing either fails silently.
  //
  // 1. `${configDir}` on outDir. A file-path option in an extended config is
  //    resolved against that config's directory, not the consumer's. A plain
  //    "dist" here would emit into this package's directory, so every
  //    consumer's build would produce nothing and its npm tarball would ship
  //    empty. The template is not resolved that way. It is replaced with the
  //    consuming project's directory. (typescript 6.0.3,
  //    normalizeNonListOptionValue.)
  //
  // 2. No `extends`, and no `include`/`exclude`/`files`. Extending a preset here
  //    would apply it again over the consumer's config and undo the consumer's
  //    overrides. A NodeNext package would become ESNext/Bundler. An `include`
  //    here would replace the consumer's, resolved against a directory inside
  //    node_modules.
  //
  // `rootDir` is not set either. It differs between consumers ("." or "src"),
  // and a wrong guess changes the dist/ layout without an error.
  "compilerOptions": {
    "noEmit": false,
    "outDir": "${configDir}/dist",
    "declaration": true,
    "declarationMap": true,
    // Lets an emitting build keep source-shipped.json's
    // `allowImportingTsExtensions`, which TS otherwise rejects (TS5096). It also
    // lets a source-shipped dependency whose imports end in .ts typecheck
    // (TS5097).
    "rewriteRelativeImportExtensions": true
  }
}
