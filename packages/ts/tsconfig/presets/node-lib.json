{
  // A node library: the ES2022 runtime, node globals, no DOM.
  //
  // `customConditions: ["bun"]` is not set here. Packages differ on it, so each
  // package that needs it sets it. See ./bun-lib.json for what the setting
  // decides and how a wrong value causes a TS2307 that shows up late.
  "extends": "./source-shipped.json",
  "compilerOptions": {
    "lib": ["ES2022"],
    "types": ["node"]
  }
}
