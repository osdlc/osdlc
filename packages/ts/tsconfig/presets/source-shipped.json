{
  // The shared bar plus two options for packages consumed as source. Such a
  // package resolves through a `bun` export condition to TypeScript, not to a
  // built `dist/`, so an import may name its `.ts` extension.
  //
  // These two options are kept out of ./base.json because an outside consumer
  // would not want them. A package that builds with tsc and imports `./x.js`
  // uses base. A package consumed as source uses this file, directly or through
  // ./node-lib.json, ./bun-lib.json or ./vue.json.
  //
  // The two options must be set together. TypeScript rejects
  // `allowImportingTsExtensions` unless one of `noEmit`, `emitDeclarationOnly`
  // or `rewriteRelativeImportExtensions` is set (TS5096). ./build.json sets
  // `rewriteRelativeImportExtensions`, so an emitting build can override this
  // file's `noEmit` without hitting the same error.
  "extends": "./base.json",
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "noEmit": true
  }
}
