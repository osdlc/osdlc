{
  "name": "@osdlc/typed-gh",
  "version": "0.14.0",
  "description": "A typed GitHub client for TypeScript over the gh CLI. A total PullRequest/Review/CheckRun model, pure argv builders and parsers, and a tri-modal client \u2014 queries return parsed values, mutations throw, raw() is the escape hatch. Uses gh's own credentials; reads no token.",
  "license": "MIT OR Apache-2.0",
  "author": "sksizer",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    }
  },
  "files": [
    "dist/",
    "README.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "CONTRIBUTING.md",
    "LICENSE-MIT",
    "LICENSE-APACHE"
  ],
  "dependencies": {
    "@osdlc/command-seam": "workspace:^",
    "@osdlc/typed-git": "workspace:^",
    "@osdlc/result": "workspace:^"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "test": "vitest run",
    "smoke": "node tests/smoke.mjs",
    "prepublishOnly": "npm run clean && npm run build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "oxlint .",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.build.json --noEmit",
    "coverage": "vitest run --coverage"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/osdlc/osdlc.git",
    "directory": "packages/ts/typed-gh"
  },
  "homepage": "https://github.com/osdlc/osdlc/tree/main/packages/ts/typed-gh#readme",
  "bugs": "https://github.com/osdlc/osdlc/issues",
  "keywords": [
    "github",
    "gh",
    "pull-request",
    "typescript",
    "cli-wrapper",
    "dependency-injection"
  ],
  "devDependencies": {
    "@osdlc/prettier-config": "workspace:^",
    "@osdlc/tsconfig": "workspace:^",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "oxlint": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
