{
  // Emit config for the published dist/; the dev tsconfig.json stays noEmit.
  // The source only. Unlike the pure wrapper packages, this one uses Node
  // (node:fs, process), so it keeps the Node types. The build script copies
  // the committed wasm/ into dist/wasm/, where the emitted import finds it.
  "extends": ["./tsconfig.json", "@osdlc/tsconfig/build"],
  "compilerOptions": {
    "rootDir": "src",
    "types": ["node"],
    // src/ is not published, so a declaration map would point at nothing.
    "declarationMap": false
  },
  "include": ["src"]
}
