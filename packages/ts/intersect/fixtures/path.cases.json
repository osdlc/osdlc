{
  "op": "intersects",
  "cases": [
    {
      "name": "exact match: identical no-wildcard paths overlap",
      "a": "src/siteA/components",
      "b": "src/siteA/components",
      "expect": true,
      "pending": false
    },
    {
      "name": "exact match: a bare path does not match a child (no dir inference)",
      "a": "src/siteA/components",
      "b": "src/siteA/components/Button.vue",
      "expect": false,
      "pending": false
    },
    {
      "name": "subtree **: an explicit subtree matches a file beneath it",
      "a": "src/siteA/components/**",
      "b": "src/siteA/components/Button.vue",
      "expect": true,
      "pending": false
    },
    {
      "name": "subtree **: glob overlaps a concrete file inside it",
      "a": "src/**/*.ts",
      "b": "src/api/handler.ts",
      "expect": true,
      "pending": false
    },
    {
      "name": "star *: single-star matches within one segment",
      "a": "src/*.ts",
      "b": "src/index.ts",
      "expect": true,
      "pending": false
    },
    {
      "name": "star *: single-star does not cross a separator",
      "a": "src/*.ts",
      "b": "src/api/index.ts",
      "expect": false,
      "pending": false
    },
    {
      "name": "question ?: matches exactly one character",
      "a": "file?.ts",
      "b": "file1.ts",
      "expect": true,
      "pending": false
    },
    {
      "name": "question ?: does not match two characters",
      "a": "file?.ts",
      "b": "file10.ts",
      "expect": false,
      "pending": false
    },
    {
      "name": "braces {a,b}: an alternative matches",
      "a": "**/*.{vue,html}",
      "b": "src/siteA/Button.vue",
      "expect": true,
      "pending": false
    },
    {
      "name": "braces {a,b}: a non-listed extension does not match",
      "a": "**/*.{vue,html}",
      "b": "src/siteA/app.css",
      "expect": false,
      "pending": false
    },
    {
      "name": "character class [...]: an in-range character matches",
      "a": "file[0-9].ts",
      "b": "file3.ts",
      "expect": true,
      "pending": false
    },
    {
      "name": "character class [...]: an out-of-range character does not match",
      "a": "file[0-9].ts",
      "b": "fileA.ts",
      "expect": false,
      "pending": false
    },
    {
      "name": "negated class [!...]: excludes the listed characters",
      "a": "file[!0-9].ts",
      "b": "fileA.ts",
      "expect": true,
      "pending": false
    },
    {
      "name": "disjoint: non-overlapping subtrees are false",
      "a": "src/api/**",
      "b": "src/web/**",
      "expect": false,
      "pending": false
    },
    {
      "name": "set input: an array is the union of its patterns",
      "a": ["src/api/**", "src/db/**"],
      "b": "src/db/pool.ts",
      "expect": true,
      "pending": false
    },
    {
      "name": "set input: disjoint sets do not overlap",
      "a": ["a/**"],
      "b": ["b/**", "c/**"],
      "expect": false,
      "pending": false
    },
    {
      "name": "matches: path is inside the first pattern of the set",
      "op": "matches",
      "path": "src/api/user.ts",
      "patterns": ["src/api/**", "**/*.test.ts"],
      "expect": true,
      "pending": false
    },
    {
      "name": "matches: path matches none of the set",
      "op": "matches",
      "path": "README.md",
      "patterns": ["src/api/**", "**/*.test.ts"],
      "expect": false,
      "pending": false
    },
    {
      "name": "whichMatch: returns every matching pattern in registration order",
      "op": "whichMatch",
      "path": "src/api/user.test.ts",
      "patterns": ["src/api/**", "**/*.test.ts", "docs/**"],
      "expect": ["src/api/**", "**/*.test.ts"],
      "pending": false
    },
    {
      "name": "whichMatch: empty when nothing matches",
      "op": "whichMatch",
      "path": "README.md",
      "patterns": ["src/api/**", "**/*.test.ts"],
      "expect": [],
      "pending": false
    },
    {
      "name": "unicode: ? spans one astral character, not one code unit",
      "op": "matches",
      "path": "a😀b.ts",
      "patterns": ["a?b.ts"],
      "expect": true
    },
    {
      "name": "unicode: a character class holds an astral character as one member",
      "op": "matches",
      "path": "😀.ts",
      "patterns": ["[😀x].ts"],
      "expect": true
    },
    {
      "name": "negated class: excluding the whole fallback alphabet still meets ?",
      "op": "intersects",
      "a": "[^a-zA-Z0-9._-]",
      "b": "?",
      "expect": true
    },
    {
      "name": "negated class: excluding the whole fallback alphabet still meets another negated class",
      "op": "intersects",
      "a": "[^a-zA-Z0-9._-]",
      "b": "[^b]",
      "expect": true
    },
    {
      "name": "negated class: two classes that together exclude the fallback alphabet still overlap",
      "op": "intersects",
      "a": "[^a-zA-Z]",
      "b": "[^0-9._-]",
      "expect": true
    },
    {
      "name": "negated class: a negated class and the class it negates do not overlap",
      "op": "intersects",
      "a": "[^a-z]",
      "b": "[a-z]",
      "expect": false
    },
    {
      "name": "literal path: [id] in a path is a name, not a class",
      "op": "matches",
      "path": "pages/[id].vue",
      "patterns": "pages/d.vue",
      "expect": false
    },
    {
      "name": "literal path: the escaped pattern matches the same name",
      "op": "matches",
      "path": "pages/[id].vue",
      "patterns": "pages/\\[id\\].vue",
      "expect": true
    },
    {
      "name": "literal path: * in a path is a name, not a wildcard",
      "op": "matches",
      "path": "*",
      "patterns": "a",
      "expect": false
    },
    {
      "name": "literal path: the escaped * pattern matches the name",
      "op": "matches",
      "path": "*",
      "patterns": "\\*",
      "expect": true
    },
    {
      "name": "literal path: a pattern wildcard still matches a plain path",
      "op": "matches",
      "path": "a",
      "patterns": "*",
      "expect": true
    },
    {
      "name": "literal path: whichMatch reads the path literally",
      "op": "whichMatch",
      "path": "src/[a].ts",
      "patterns": ["src/a.ts", "src/\\[a\\].ts"],
      "expect": ["src/\\[a\\].ts"]
    },
    {
      "name": "literal path: a path with an extglob lookalike is a name",
      "op": "matches",
      "path": "+(a|b)",
      "patterns": "+\\(a|b\\)",
      "expect": true
    },
    {
      "name": "depth: 64 nested brace groups are accepted",
      "op": "intersects",
      "a": "{{{{{{{{{{{{{{{{{{{{{{{{{{{{{{{{{{{{{{{{{{{{{{{{{{{{{{{{{{{{{{{{a}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}",
      "b": "a",
      "expect": true
    },
    {
      "name": "depth: 65 nested brace groups throw PATTERN_TOO_DEEP",
      "op": "intersects",
      "a": "{{{{{{{{{{{{{{{{{{{{{{{{{{{{{{{{{{{{{{{{{{{{{{{{{{{{{{{{{{{{{{{{{a}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}",
      "b": "a",
      "throws": true,
      "code": "PATTERN_TOO_DEEP"
    },
    {
      "name": "syntax: a number range {1..3} throws UNSUPPORTED_SYNTAX",
      "op": "intersects",
      "a": "a{1..3}",
      "b": "a",
      "throws": true,
      "code": "UNSUPPORTED_SYNTAX"
    },
    {
      "name": "syntax: a negative number range {-2..2} throws UNSUPPORTED_SYNTAX",
      "op": "intersects",
      "a": "a{-2..2}",
      "b": "a",
      "throws": true,
      "code": "UNSUPPORTED_SYNTAX"
    },
    {
      "name": "syntax: a number range with a step {1..9..2} throws UNSUPPORTED_SYNTAX",
      "op": "intersects",
      "a": "a{1..9..2}",
      "b": "a",
      "throws": true,
      "code": "UNSUPPORTED_SYNTAX"
    },
    {
      "name": "syntax: a brace group holding a slash throws UNSUPPORTED_SYNTAX",
      "op": "intersects",
      "a": "{x/y,z}",
      "b": "a",
      "throws": true,
      "code": "UNSUPPORTED_SYNTAX"
    },
    {
      "name": "syntax: a class holding a slash throws UNSUPPORTED_SYNTAX",
      "op": "intersects",
      "a": "[a/b]",
      "b": "a",
      "throws": true,
      "code": "UNSUPPORTED_SYNTAX"
    },
    {
      "name": "syntax: the extglob +(a|b) throws UNSUPPORTED_SYNTAX",
      "op": "intersects",
      "a": "+(a|b)",
      "b": "a",
      "throws": true,
      "code": "UNSUPPORTED_SYNTAX"
    },
    {
      "name": "syntax: the extglob @(a|b) throws UNSUPPORTED_SYNTAX",
      "op": "intersects",
      "a": "@(a|b)",
      "b": "a",
      "throws": true,
      "code": "UNSUPPORTED_SYNTAX"
    },
    {
      "name": "syntax: the extglob !(b) throws UNSUPPORTED_SYNTAX",
      "op": "intersects",
      "a": "!(b)",
      "b": "a",
      "throws": true,
      "code": "UNSUPPORTED_SYNTAX"
    },
    {
      "name": "syntax: the extglob ?(a) throws UNSUPPORTED_SYNTAX",
      "op": "intersects",
      "a": "?(a)",
      "b": "a",
      "throws": true,
      "code": "UNSUPPORTED_SYNTAX"
    },
    {
      "name": "syntax: the extglob *(a) throws UNSUPPORTED_SYNTAX",
      "op": "intersects",
      "a": "*(a)",
      "b": "a",
      "throws": true,
      "code": "UNSUPPORTED_SYNTAX"
    },
    {
      "name": "syntax: a brace group that holds a slash throws UNSUPPORTED_SYNTAX in matches",
      "op": "matches",
      "path": "x/y",
      "patterns": "{x/y,z}",
      "throws": true,
      "code": "UNSUPPORTED_SYNTAX"
    },
    {
      "name": "syntax: a class that holds a slash throws UNSUPPORTED_SYNTAX in matches",
      "op": "matches",
      "path": "a",
      "patterns": "[a/b]",
      "throws": true,
      "code": "UNSUPPORTED_SYNTAX"
    },
    {
      "name": "syntax: an unclosed { with no closer later is a literal",
      "op": "matches",
      "path": "a{1..3",
      "patterns": "a{1..3",
      "expect": true
    },
    {
      "name": "syntax: a lone ( after + with no ) is a literal",
      "op": "matches",
      "path": "+(a",
      "patterns": "+(a",
      "expect": true
    },
    {
      "name": "syntax: an escaped extglob is a literal",
      "op": "matches",
      "path": "+(a|b)",
      "patterns": "+\\(a|b\\)",
      "expect": true
    },
    {
      "name": "syntax: a one-branch group {a} is the group, not literal text",
      "op": "matches",
      "path": "a",
      "patterns": "{a}",
      "expect": true
    },
    {
      "name": "syntax: [[:alpha:]] is not a POSIX class",
      "op": "matches",
      "path": "a",
      "patterns": "[[:alpha:]]",
      "expect": false
    },
    {
      "name": "syntax: a reversed range [c-a] matches nothing",
      "op": "matches",
      "path": "a",
      "patterns": "[c-a]",
      "expect": false
    },
    {
      "name": "syntax: a backslash inside a class is literal",
      "op": "matches",
      "path": "]",
      "patterns": "[\\]]",
      "expect": false
    },
    {
      "name": "syntax: * matches the empty segment",
      "op": "matches",
      "path": "src//a.ts",
      "patterns": "src/*/a.ts",
      "expect": true
    },
    {
      "name": "syntax: x}/{y is plain text, a stray } before an opening { in a later segment",
      "op": "matches",
      "path": "x}/{y",
      "patterns": "x\\}/\\{y",
      "expect": true
    },
    {
      "name": "syntax: x}/{y as a pattern is plain text and matches itself",
      "op": "intersects",
      "a": "x}/{y",
      "b": "x}/{y",
      "expect": true
    },
    {
      "name": "syntax: {a}/b} is plain text for the second segment",
      "op": "intersects",
      "a": "{a}/b}",
      "b": "a/b}",
      "expect": true
    },
    {
      "name": "syntax: []/] throws UNSUPPORTED_SYNTAX",
      "op": "intersects",
      "a": "[]/]",
      "b": "a",
      "throws": true,
      "code": "UNSUPPORTED_SYNTAX"
    },
    {
      "name": "syntax: {[}/x] throws UNSUPPORTED_SYNTAX",
      "op": "intersects",
      "a": "{[}/x]",
      "b": "a",
      "throws": true,
      "code": "UNSUPPORTED_SYNTAX"
    }
  ]
}
