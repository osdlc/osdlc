{
  "op": "overlapping",
  "cases": [
    {
      "name": "overlapping: returns the query patterns that overlap the candidate set",
      "query": ["src/api/**", "src/db/schema.ts"],
      "candidates": ["src/api/routes/*.ts", "docs/**"],
      "expect": ["src/api/**"],
      "pending": false
    },
    {
      "name": "overlapping: empty when no query pattern overlaps",
      "query": ["docs/**"],
      "candidates": ["src/api/**", "src/db/schema.ts"],
      "expect": [],
      "pending": false
    },
    {
      "name": "overlapping: preserves query order across multiple overlaps",
      "query": ["src/api/**", "src/db/**", "docs/**"],
      "candidates": ["src/db/pool.ts", "src/api/user.ts"],
      "expect": ["src/api/**", "src/db/**"],
      "pending": false
    },
    {
      "name": "overlapping: a single string query is a one-element set",
      "query": "src/api/**",
      "candidates": ["src/api/routes/list.ts", "docs/**"],
      "expect": ["src/api/**"],
      "pending": false
    },
    {
      "name": "witness: overlapping patterns return a concrete common path",
      "op": "witness",
      "a": "src/api/**",
      "b": "src/**/handler.ts",
      "expect": "src/api/handler.ts",
      "pending": false
    },
    {
      "name": "witness: disjoint patterns return null",
      "op": "witness",
      "a": "src/api/**",
      "b": "src/web/**",
      "expect": null,
      "pending": false
    },
    {
      "name": "witness: the shared segment of two stars is a real, non-empty segment",
      "op": "witness",
      "a": "src/*",
      "b": "src/*",
      "expect": "src/a"
    },
    {
      "name": "witness: a common segment-vector no path string can spell is reported as none",
      "op": "witness",
      "a": "*/*",
      "b": "*/{,.a}",
      "expect": null
    },
    {
      "name": "witness: a negated class that excludes the fallback alphabet still has a one-character witness",
      "op": "witness",
      "a": "[^a-zA-Z0-9._-]",
      "b": "?",
      "expect": "`"
    },
    {
      "name": "witness: keeps searching past an empty segment before a brace of nothing",
      "op": "witness",
      "a": "a/**/{,x}",
      "b": "a/{,y}/**",
      "expect": "a/y/x"
    },
    {
      "name": "witness: keeps searching past an empty segment before **",
      "op": "witness",
      "a": "a//**",
      "b": "**",
      "expect": "a//a"
    },
    {
      "name": "witness: two patterns with an empty segment before ** share a longer path",
      "op": "witness",
      "a": "a//**",
      "b": "a//**",
      "expect": "a//a"
    },
    {
      "name": "witness: a leading empty segment before ** is searched past",
      "op": "witness",
      "a": "**",
      "b": "//**",
      "expect": "//a"
    },
    {
      "name": "witness: a common path that only ends in an empty segment is still null",
      "op": "witness",
      "a": "a/{,x}",
      "b": "a/{,y}",
      "expect": null
    },
    {
      "name": "witness: a path with glob characters is read back literally",
      "op": "witness",
      "a": "\\[a\\]",
      "b": "\\[a\\]",
      "expect": "[a]"
    },
    {
      "name": "overlapping: a single string is a one-element candidate set",
      "op": "overlapping",
      "query": ["a/**", "b/**"],
      "candidates": "a/x",
      "expect": ["a/**"]
    },
    {
      "name": "overlapping: filters the query, not the candidates",
      "op": "overlapping",
      "query": ["src/api/**", "src/db/schema.ts"],
      "candidates": ["src/api/routes/*.ts", "docs/**"],
      "expect": ["src/api/**"]
    }
  ]
}
