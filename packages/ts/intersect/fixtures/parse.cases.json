{
  "op": "parse",
  "cases": [
    {
      "name": "parse: splits on the / separator",
      "path": "src/api/**",
      "expect": ["src", "api", "**"]
    },
    {
      "name": "parse: a trailing separator is normalized off",
      "path": "src/api/",
      "expect": ["src", "api"]
    },
    {
      "name": "parse: a custom separator splits on that character",
      "path": "a:b:c",
      "opts": {
        "separator": ":"
      },
      "expect": ["a", "b", "c"]
    },
    {
      "name": "parse: an empty separator acts as /",
      "path": "a/b",
      "opts": {
        "separator": ""
      },
      "expect": ["a", "b"]
    },
    {
      "name": "parse: an empty separator on the empty string gives one empty segment",
      "path": "",
      "opts": {
        "separator": ""
      },
      "expect": [""]
    },
    {
      "name": "parse: an empty separator does not split an astral character",
      "path": "😀/b",
      "opts": {
        "separator": ""
      },
      "expect": ["😀", "b"]
    }
  ]
}
