{
  "op": "segments.intersects",
  "cases": [
    {
      "name": "intersects: glob subtree overlaps a concrete file",
      "a": ["src", "**", "*.ts"],
      "b": ["src", "api", "handler.ts"],
      "expect": true,
      "pending": false
    },
    {
      "name": "intersects: disjoint subtrees do not overlap",
      "a": ["src", "api", "**"],
      "b": ["src", "web", "**"],
      "expect": false,
      "pending": false
    },
    {
      "name": "intersects: exact segment paths that are equal overlap",
      "a": ["src", "siteA", "components"],
      "b": ["src", "siteA", "components"],
      "expect": true,
      "pending": false
    },
    {
      "name": "intersects: an exact path does not overlap a child path",
      "a": ["src", "siteA", "components"],
      "b": ["src", "siteA", "components", "Button.vue"],
      "expect": false,
      "pending": false
    },
    {
      "name": "intersects: globstar spans zero segments",
      "a": ["a", "**", "b"],
      "b": ["a", "b"],
      "opts": { "globstarMatchesZero": true },
      "expect": true,
      "pending": false
    },
    {
      "name": "matches: subtree glob matches a nested segmented path",
      "op": "segments.matches",
      "path": ["src", "siteA", "components", "Button.vue"],
      "pattern": ["src", "**", "*.vue"],
      "expect": true,
      "pending": false
    },
    {
      "name": "matches: single-star does not cross a segment boundary",
      "op": "segments.matches",
      "path": ["src", "api", "user.ts"],
      "pattern": ["src", "*"],
      "expect": false,
      "pending": false
    },
    {
      "name": "witness: overlapping patterns yield a common segmented path",
      "op": "segments.witness",
      "a": ["src", "api", "**"],
      "b": ["src", "**", "handler.ts"],
      "expect": ["src", "api", "handler.ts"],
      "pending": false
    },
    {
      "name": "witness: disjoint patterns yield null",
      "op": "segments.witness",
      "a": ["src", "api", "**"],
      "b": ["src", "web", "**"],
      "expect": null,
      "pending": false
    },
    {
      "name": "intersects: leading-dot exclusion survives a zero-width star (*.env vs .env)",
      "a": ["*.env"],
      "b": [".env"],
      "expect": false,
      "pending": false
    },
    {
      "name": "intersects: later-position dot still matches (*.env vs a.env)",
      "a": ["*.env"],
      "b": ["a.env"],
      "expect": true,
      "pending": false
    },
    {
      "name": "intersects: leading-dot exclusion survives a globstar prefix (** */*.env vs .env)",
      "a": ["**", "*.env"],
      "b": [".env"],
      "expect": false,
      "pending": false
    },
    {
      "name": "matches: a wildcard segment does not match a leading-dot path (.vue vs *.vue)",
      "op": "segments.matches",
      "path": [".vue"],
      "pattern": ["*.vue"],
      "expect": false,
      "pending": false
    },
    {
      "name": "matches: an explicit leading literal dot still matches (.env vs .*)",
      "op": "segments.matches",
      "path": [".env"],
      "pattern": [".*"],
      "expect": true,
      "pending": false
    }
  ]
}
