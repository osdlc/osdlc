[
  {
    "name": "a-named-profile",
    "input": {
      "layers": [
        "mini"
      ],
      "profiles": {
        "review": [
          "alpha/standard",
          "beta/standard"
        ]
      },
      "binding": {
        "profile": "review"
      }
    },
    "expected": {
      "ok": true,
      "value": {
        "kind": "chosen",
        "resolved": {
          "tool": "alpha",
          "model": "mid-1",
          "effortUnchecked": false,
          "contextUnchecked": false,
          "text": "alpha/standard",
          "from": {
            "kind": "tier",
            "tier": "standard"
          },
          "check": {
            "kind": "ok"
          }
        },
        "warnings": [],
        "skipped": [],
        "trace": [
          "alpha/standard: taken"
        ],
        "summary": "chosen: alpha/standard"
      }
    }
  },
  {
    "name": "a-named-profile-walks-with-availability",
    "input": {
      "layers": [
        "mini"
      ],
      "profiles": {
        "review": [
          "alpha/standard",
          "beta/standard"
        ]
      },
      "binding": {
        "profile": "review"
      },
      "availability": {
        "alpha/standard": {
          "reason": "not-installed"
        }
      }
    },
    "expected": {
      "ok": true,
      "value": {
        "kind": "chosen",
        "resolved": {
          "tool": "beta",
          "model": "gpt-x",
          "effortUnchecked": false,
          "contextUnchecked": false,
          "text": "beta/standard",
          "from": {
            "kind": "tier",
            "tier": "standard"
          },
          "check": {
            "kind": "ok"
          }
        },
        "warnings": [],
        "skipped": [
          {
            "ref": "alpha/standard",
            "reason": "not-installed"
          }
        ],
        "trace": [
          "alpha/standard: skipped: unavailable (not-installed)",
          "beta/standard: taken"
        ],
        "summary": "chosen: beta/standard"
      }
    }
  },
  {
    "name": "a-builtin-profile",
    "input": {
      "layers": [
        "mini"
      ],
      "knownTools": [
        "alpha",
        "beta"
      ],
      "profiles": {},
      "binding": {
        "profile": "default"
      }
    },
    "expected": {
      "ok": true,
      "value": {
        "kind": "chosen",
        "resolved": {
          "tool": "alpha",
          "model": "mid-1",
          "effortUnchecked": false,
          "contextUnchecked": false,
          "text": "alpha/standard",
          "from": {
            "kind": "tier",
            "tier": "standard"
          },
          "check": {
            "kind": "ok"
          }
        },
        "warnings": [],
        "skipped": [],
        "trace": [
          "*/standard: expands to alpha/standard, beta/standard",
          "alpha/standard: taken"
        ],
        "summary": "chosen: alpha/standard"
      }
    }
  },
  {
    "name": "an-invalid-profile-is-an-ok-invalid-choice",
    "input": {
      "layers": [
        "mini"
      ],
      "profiles": {
        "broken": [
          "nope/fast"
        ]
      },
      "binding": {
        "profile": "broken"
      }
    },
    "expected": {
      "ok": true,
      "value": {
        "kind": "invalid",
        "errors": [
          {
            "entry": "nope/fast",
            "message": "unknown tool 'nope'; known: alpha, beta, gamma, delta",
            "error": {
              "kind": "unknown-tool",
              "tool": "nope",
              "model": "fast",
              "message": "unknown tool 'nope'; known: alpha, beta, gamma, delta"
            }
          }
        ],
        "skipped": [],
        "trace": [
          "nope/fast: invalid (unknown tool 'nope'; known: alpha, beta, gamma, delta)"
        ],
        "summary": "invalid: nope/fast: unknown tool 'nope'; known: alpha, beta, gamma, delta"
      }
    }
  },
