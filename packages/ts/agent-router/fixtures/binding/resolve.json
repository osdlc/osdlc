  {
    "name": "a-wildcard-tool-reference-walks-the-chain",
    "input": {
      "layers": [
        "mini"
      ],
      "knownTools": [
        "alpha",
        "gamma"
      ],
      "profiles": {},
      "binding": {
        "tool": "*/fast"
      },
      "availability": {
        "alpha/fast": {
          "reason": "cooling-down"
        }
      }
    },
    "expected": {
      "ok": true,
      "value": {
        "kind": "chosen",
        "resolved": {
          "tool": "gamma",
          "model": "anthropic/small-1",
          "effortUnchecked": false,
          "contextUnchecked": false,
          "text": "gamma/fast",
          "from": {
            "kind": "tier",
            "tier": "fast"
          },
          "check": {
            "kind": "ok"
          }
        },
        "warnings": [],
        "skipped": [
          {
            "ref": "alpha/embed-1",
            "reason": "not-agent",
            "detail": "anthropic/embed-1 is an embedding model"
          },
          {
            "ref": "alpha/plain-1",
            "reason": "not-agent",
            "detail": "anthropic/plain-1 is not an agent model"
          },
          {
            "ref": "gamma/anthropic/embed-1",
            "reason": "not-agent",
            "detail": "anthropic/embed-1 is an embedding model"
          },
          {
            "ref": "gamma/anthropic/plain-1",
            "reason": "not-agent",
            "detail": "anthropic/plain-1 is not an agent model"
          },
          {
            "ref": "alpha/fast",
            "reason": "cooling-down"
          }
        ],
        "trace": [
          "alpha/embed-1: skipped: anthropic/embed-1 is an embedding model (from */fast)",
          "alpha/plain-1: skipped: anthropic/plain-1 is not an agent model (from */fast)",
          "gamma/anthropic/embed-1: skipped: anthropic/embed-1 is an embedding model (from */fast)",
          "gamma/anthropic/plain-1: skipped: anthropic/plain-1 is not an agent model (from */fast)",
          "*/fast: expands to alpha/fast, gamma/fast, gamma/ollama/qwen3:4b",
          "alpha/fast: skipped: unavailable (cooling-down)",
          "gamma/fast: taken"
        ],
        "summary": "chosen: gamma/fast"
      }
    }
  },
