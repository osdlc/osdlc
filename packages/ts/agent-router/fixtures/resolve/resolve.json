  {
    "name": "error-unsupported-effort",
    "input": {
      "layers": [
        "mini"
      ],
      "ref": "alpha/big@none"
    },
    "expected": {
      "ok": false,
      "error": {
        "kind": "unsupported-effort",
        "tool": "alpha",
        "model": "big",
        "message": "effort 'none' is not supported for model 'big' on 'alpha'; supported: low, medium, high",
        "effort": "none",
        "supported": [
          "low",
          "medium",
          "high"
        ]
      }
    }
  },
  {
    "name": "error-effort-on-a-tool-that-takes-none",
    "input": {
      "layers": [
        "mini"
      ],
      "ref": "gamma/anthropic/small-1@high"
    },
    "expected": {
      "ok": false,
      "error": {
        "kind": "unsupported-effort",
        "tool": "gamma",
        "model": "anthropic/small-1",
        "message": "effort 'high' is not supported for model 'anthropic/small-1' on 'gamma'; it takes no effort",
        "effort": "high",
        "supported": []
      }
    }
  },
  {
    "name": "error-unknown-model-under-strict",
    "input": {
      "layers": [
        "mini"
      ],
      "strict": true,
      "ref": "alpha/not-a-model"
    },
    "expected": {
      "ok": false,
      "error": {
        "kind": "unknown-model",
        "tool": "alpha",
        "model": "not-a-model",
        "message": "model 'not-a-model' is not in the model catalogue for 'alpha', and router.strict refuses unknown models"
      }
    }
  },
  {
    "name": "warning-unknown-model",
    "input": {
      "layers": [
        "mini"
      ],
      "ref": "alpha/not-a-model"
    },
    "expected": {
      "ok": true,
      "value": {
        "tool": "alpha",
        "model": "not-a-model",
        "effortUnchecked": false,
        "contextUnchecked": false,
        "text": "alpha/not-a-model",
        "from": {
          "kind": "name",
          "name": "not-a-model"
        },
        "check": {
          "kind": "warning",
          "code": "unknown-model",
          "message": "model 'not-a-model' is not in the model catalogue for 'alpha'; it is passed as written"
        }
      }
    }
  },
