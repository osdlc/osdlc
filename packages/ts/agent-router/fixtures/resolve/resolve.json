  {
    "name": "wildcard-is-an-error",
    "input": {
      "layers": [
        "mini"
      ],
      "ref": "*/fast"
    },
    "expected": {
      "ok": false,
      "error": {
        "kind": "wildcard",
        "tool": "*",
        "model": "fast",
        "message": "'*/fast' names every tool; only a profile walk expands it"
      }
    }
  },
