[
  {
    "name": "tool-only",
    "input": {
      "layers": [
        "mini"
      ],
      "ref": "alpha"
    },
    "expected": {
      "ok": true,
      "value": {
        "tool": "alpha",
        "effortUnchecked": false,
        "contextUnchecked": false,
        "text": "alpha",
        "from": {
          "kind": "default"
        },
        "check": {
          "kind": "ok"
        }
      }
    }
  },
