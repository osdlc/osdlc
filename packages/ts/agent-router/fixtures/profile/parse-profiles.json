  },
  {
    "name": "redefining-default-replaces-it-whole",
    "input": {
      "value": {
        "default": [
          "claude/max"
        ]
      }
    },
    "expected": {
      "ok": true,
      "value": {
        "default": {
          "order": [
            {
              "tool": "claude",
              "model": "max"
            }
          ]
        },
        "small": {
          "order": [
            {
              "tool": "*",
              "model": "fast"
            }
          ]
        }
      }
    }
  },
  {
    "name": "redefining-small-keeps-the-builtin-position",
    "input": {
      "value": {
        "zeta": [
          "claude/fast"
        ],
        "small": {
          "order": [
            "codex/fast"
          ],
          "context": "1m"
        }
      }
    },
    "expected": {
      "ok": true,
      "value": {
        "default": {
          "order": [
            {
              "tool": "*",
              "model": "standard"
            }
          ]
        },
        "small": {
          "order": [
            {
              "tool": "codex",
              "model": "fast"
            }
          ],
          "context": 1000000
        },
        "zeta": {
          "order": [
            {
              "tool": "claude",
              "model": "fast"
            }
          ]
        }
      }
    }
  },
  {
    "name": "a-profile-with-a-shape-error",
    "input": {
      "value": {
        "good": [
          "claude/fast"
        ],
        "bad": []
      }
    },
    "expected": {
      "ok": false,
      "error": {
        "kind": "invalid-shape"
      }
    }
  },
  {
    "name": "a-profile-with-an-unknown-key",
    "input": {
      "value": {
        "bad": {
          "order": [
            "claude/fast"
          ],
          "nope": 1
        }
      }
    },
    "expected": {
      "ok": false,
      "error": {
        "kind": "invalid-shape"
      }
    }
  },
  {
    "name": "a-bad-ref-names-the-profile",
    "input": {
      "value": {
        "mine": [
          "claude/fast",
          "claude/opus[1m]"
        ]
      }
    },
    "expected": {
      "ok": false,
      "error": {
        "kind": "invalid-ref",
        "index": 1,
        "error": {
          "kind": "native-bracket",
          "text": "claude/opus[1m]",
          "message": "a context size is written [ctx=1m], not a tool's own [1m]: \"claude/opus[1m]\""
        },
        "message": "profile 'mine': order[1]: a context size is written [ctx=1m], not a tool's own [1m]: \"claude/opus[1m]\""
      }
    }
  },
  {
    "name": "a-bad-context-names-the-profile",
    "input": {
      "value": {
        "mine": {
          "order": [
            "claude/fast"
          ],
          "context": "x"
        }
      }
    },
    "expected": {
      "ok": false,
      "error": {
        "kind": "invalid-context",
        "message": "profile 'mine': context: must be digits plus k or m (1m, 200k); got 'x'"
      }
    }
  },
  {
    "name": "the-first-bad-profile-wins",
    "input": {
      "value": {
        "a": [
