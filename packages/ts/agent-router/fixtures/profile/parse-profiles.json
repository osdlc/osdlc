    "expected": {
      "ok": false,
      "error": {
        "kind": "invalid-ref",
        "index": 0,
        "error": {
          "kind": "whitespace",
          "text": "bad ref",
          "message": "model reference contains whitespace: \"bad ref\""
        },
        "message": "profile 'a': order[0]: model reference contains whitespace: \"bad ref\""
      }
    }
  },
  {
