[
  {
    "name": "bare-list",
    "input": {
      "value": [
        "claude/fast",
        "codex/fast"
      ]
    },
    "expected": {
      "ok": true,
      "value": {
        "order": [
          {
            "tool": "claude",
            "model": "fast"
          },
          {
            "tool": "codex",
            "model": "fast"
          }
        ]
      }
    }
  },
  {
    "name": "bare-list-one-entry",
    "input": {
      "value": [
        "claude"
      ]
    },
    "expected": {
      "ok": true,
      "value": {
        "order": [
          {
            "tool": "claude"
          }
        ]
      }
    }
  },
  {
    "name": "bare-list-wildcard-and-qualifiers",
    "input": {
      "value": [
        "*/fast[local]",
        "claude/opus[ctx=1m]@high"
      ]
    },
    "expected": {
      "ok": true,
      "value": {
        "order": [
          {
            "tool": "*",
            "model": "fast",
            "qualifiers": {
              "traits": [
                "local"
              ]
            }
          },
          {
            "tool": "claude",
            "model": "opus",
            "qualifiers": {
              "traits": [],
              "ctx": 1000000
            },
            "effort": "high"
          }
        ]
      }
    }
  },
  {
    "name": "long-form-order-only",
    "input": {
      "value": {
        "order": [
          "claude/standard"
        ]
      }
    },
    "expected": {
      "ok": true,
      "value": {
        "order": [
          {
            "tool": "claude",
            "model": "standard"
          }
        ]
      }
    }
  },
  {
    "name": "long-form-host-and-context",
    "input": {
      "value": {
        "order": [
          "claude/standard",
          "codex/standard"
        ],
        "host": "tmux",
        "context": "1m"
      }
    },
    "expected": {
      "ok": true,
      "value": {
        "order": [
          {
            "tool": "claude",
            "model": "standard"
          },
          {
            "tool": "codex",
            "model": "standard"
          }
        ],
        "host": "tmux",
        "context": 1000000
      }
    }
  },
  {
    "name": "long-form-context-200k",
    "input": {
      "value": {
        "order": [
          "claude/fast"
        ],
        "context": "200k"
      }
    },
    "expected": {
      "ok": true,
      "value": {
        "order": [
          {
            "tool": "claude",
            "model": "fast"
          }
        ],
        "context": 200000
      }
    }
  },
  {
    "name": "empty-list",
    "input": {
      "value": []
    },
    "expected": {
      "ok": false,
      "error": {
        "kind": "invalid-shape"
      }
    }
  },
  {
    "name": "long-form-empty-order",
    "input": {
      "value": {
        "order": []
      }
    },
    "expected": {
      "ok": false,
      "error": {
        "kind": "invalid-shape"
      }
    }
  },
  {
    "name": "long-form-missing-order",
    "input": {
      "value": {
        "host": "tmux"
      }
    },
    "expected": {
      "ok": false,
      "error": {
        "kind": "invalid-shape"
      }
    }
  },
  {
    "name": "long-form-unknown-key",
    "input": {
      "value": {
        "order": [
          "claude/fast"
        ],
        "headless": true
      }
    },
    "expected": {
      "ok": false,
      "error": {
        "kind": "invalid-shape"
      }
    }
  },
  {
    "name": "long-form-host-not-a-string",
    "input": {
      "value": {
        "order": [
          "claude/fast"
        ],
        "host": 3
      }
    },
    "expected": {
      "ok": false,
      "error": {
        "kind": "invalid-shape"
      }
    }
  },
