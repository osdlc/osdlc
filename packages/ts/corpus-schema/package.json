{
  "name": "@osdlc/corpus-schema",
  "version": "0.0.0",
  "description": "Validator for the corpus-schema spec: what a folder of notes declares about itself, with typed records kept as Markdown, YAML and JSON files, checked against the schemas and links the folder holds. A library and a corpus-schema command.",
  "license": "MIT OR Apache-2.0",
  "author": "sksizer",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/osdlc/osdlc.git",
    "directory": "packages/ts/corpus-schema"
  },
  "homepage": "https://github.com/osdlc/osdlc/tree/main/packages/ts/corpus-schema#readme",
  "bugs": "https://github.com/osdlc/osdlc/issues",
  "keywords": [
    "markdown",
    "corpus-schema",
    "frontmatter",
    "json-schema",
    "validation",
    "wikilink",
    "obsidian",
    "markdown-as-data",
    "cli",
    "typescript"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "corpus-schema": "./bin/corpus-schema.js"
  },
  "files": [
    "dist/",
    "bin/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE-MIT",
    "LICENSE-APACHE",
    "SECURITY.md",
    "CONTRIBUTING.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "smoke": "node tests/smoke.mjs",
    "conformance:write": "node tests/conformance-write.ts",
    "prepublishOnly": "npm run clean && npm run build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "oxlint .",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.build.json --noEmit"
  },
  "dependencies": {
    "@osdlc/frontmatter-lossless": "workspace:^",
    "@osdlc/markdown-link": "workspace:^",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "yaml": "catalog:"
  },
  "devDependencies": {
    "@osdlc/prettier-config": "workspace:^",
    "@osdlc/tsconfig": "workspace:^",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "oxlint": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
