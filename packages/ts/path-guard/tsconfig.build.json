{
  // Emit config for the published dist/; the dev tsconfig.json stays noEmit.
  // The source only, with Node types: the package uses node:fs and node:path.
  "extends": ["./tsconfig.json", "@osdlc/tsconfig/build"],
  "compilerOptions": {
    "rootDir": ".",
    "types": ["node"],
    // The sources are not published, so a declaration map would point at nothing.
    "declarationMap": false
  },
  "include": ["index.ts", "lexical.ts", "lexical-entry.ts", "text.ts", "resolve.ts", "contained.ts"]
}
