{
  "name": "@osdlc/npm-binary",
  "version": "0.1.2",
  "description": "Ship a compiled binary through npm: one launcher package plus one os/cpu-gated package per platform, selected through optionalDependencies. Platform names, the two package.json shapes, a dependency-free Node launcher shim, platform-first publishing and the cargo target-dir lookup.",
  "license": "MIT OR Apache-2.0",
  "author": "sksizer",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/osdlc/osdlc.git",
    "directory": "packages/ts/npm-binary"
  },
  "homepage": "https://github.com/osdlc/osdlc/tree/main/packages/ts/npm-binary#readme",
  "bugs": "https://github.com/osdlc/osdlc/issues",
  "keywords": [
    "npm",
    "binary",
    "native",
    "optionalDependencies",
    "platform-packages",
    "launcher",
    "cli",
    "cargo",
    "rust",
    "distribution"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE-MIT",
    "LICENSE-APACHE",
    "SECURITY.md",
    "CONTRIBUTING.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node -e \"require('node:fs').copyFileSync('src/launcher-template.cjs', 'dist/launcher-template.cjs')\"",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "smoke": "node tests/smoke.mjs",
    "prepublishOnly": "npm run clean && npm run build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "oxlint .",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.build.json --noEmit"
  },
  "dependencies": {
    "@osdlc/command-seam": "workspace:^"
  },
  "devDependencies": {
    "@osdlc/prettier-config": "workspace:^",
    "@osdlc/tsconfig": "workspace:^",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "oxlint": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
