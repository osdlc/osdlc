{
  "name": "@osdlc/rule-review",
  "version": "0.3.0",
  "description": "Review a code change against the rule files that govern it. Finds every CLAUDE.md, AGENTS.md or other rule source whose path scope covers a changed file, and asks a headless coding agent (Claude Code, Codex, Antigravity or opencode) about each one, over only the files it governs. Also runs a folder of path-scoped check scripts. For CI and git hooks.",
  "license": "MIT OR Apache-2.0",
  "author": "sksizer",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/osdlc/osdlc.git",
    "directory": "packages/ts/rule-review"
  },
  "homepage": "https://github.com/osdlc/osdlc/tree/main/packages/ts/rule-review#readme",
  "bugs": "https://github.com/osdlc/osdlc/issues",
  "keywords": [
    "code-review",
    "ai-review",
    "rules",
    "claude-md",
    "agents-md",
    "changeset",
    "diff",
    "agent",
    "llm",
    "ci",
    "git-hooks",
    "cli"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "rule-review": "./bin/rule-review.js"
  },
  "files": [
    "dist/",
    "bin/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE-MIT",
    "LICENSE-APACHE",
    "SECURITY.md",
    "CONTRIBUTING.md"
  ],
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "build": "cli-tool-stamp-version && tsc -p tsconfig.build.json",
    "stamp-version": "cli-tool-stamp-version",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "test": "vitest run",
    "test:eval": "RULE_REVIEW_EVAL=1 vitest run tests/eval/eval.live.test.ts",
    "smoke": "node tests/smoke.mjs",
    "coverage": "vitest run --coverage",
    "prepublishOnly": "npm run clean && npm run build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "oxlint .",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.build.json --noEmit"
  },
  "dependencies": {
    "@osdlc/agent-call": "workspace:^",
    "@osdlc/cli-tool": "workspace:^",
    "@osdlc/command-seam": "workspace:^",
    "@osdlc/intersect": "workspace:^",
    "@osdlc/path-guard": "workspace:^",
    "@osdlc/typed-git": "workspace:^"
  },
  "devDependencies": {
    "@osdlc/prettier-config": "workspace:^",
    "@osdlc/tsconfig": "workspace:^",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "oxlint": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "yaml": "catalog:"
  }
}
