{
  "name": "@osdlc/code-host",
  "version": "0.3.1",
  "description": "The CodeHost port: what a code host (GitHub, Forgejo) answers about pull requests, with GitHub and Forgejo adapters, a host selector keyed on the git remote, doctor auth probes, and PR-reference parsing. Every shell-out goes through an injected command runner.",
  "license": "MIT OR Apache-2.0",
  "author": "sksizer",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/osdlc/osdlc.git",
    "directory": "packages/ts/code-host"
  },
  "homepage": "https://github.com/osdlc/osdlc/tree/main/packages/ts/code-host#readme",
  "bugs": "https://github.com/osdlc/osdlc/issues",
  "keywords": [
    "code-host",
    "github",
    "forgejo",
    "pull-request",
    "port-and-adapter"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE-MIT",
    "LICENSE-APACHE",
    "SECURITY.md",
    "CONTRIBUTING.md"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "prepublishOnly": "npm run clean && npm run build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "oxlint .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@osdlc/command-seam": "workspace:^",
    "@osdlc/config-layers": "workspace:^",
    "@osdlc/typed-gh": "workspace:^",
    "@osdlc/typed-git": "workspace:^",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@osdlc/prettier-config": "workspace:^",
    "@osdlc/tsconfig": "workspace:^",
    "@types/node": "^26.1.0",
    "@vitest/coverage-v8": "^5.0.5",
    "oxlint": "^1.65.0",
    "prettier": "3.9.6",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  }
}
