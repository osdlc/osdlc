{
  // Typechecks the source, tests/ and examples/. The build has its own include.
  "extends": "@osdlc/tsconfig/node-lib",
  "compilerOptions": {
    // etag-write is a workspace sibling that ships a `bun` condition pointing
    // at its source, so a typecheck needs no `dist/` to exist.
    "customConditions": ["bun"],
    // The package maps its own name to the source, for tsc and (in
    // vitest.config.ts) for the tests, so examples/ run before a build.
    // config-layers has no `bun` condition, so it is mapped to its source
    // too. The build config clears this and uses their `dist/`.
    "paths": {
      "@osdlc/config-layers": ["../config-layers/index.ts"],
      // Sources that config-layers imports and that ship no `bun` condition.
      "@osdlc/tiered-dirs": ["../tiered-dirs/index.ts"],
      "@osdlc/yaml-splice": ["../yaml-splice/index.ts"],
      "@osdlc/cli-tool": ["./index.ts"],
      "@osdlc/cli-tool/devlink": ["./devlink/index.ts"]
    }
  },
  "include": ["*.ts", "devlink/*.ts", "tests/*.ts", "devlink/tests/*.ts", "examples/*.ts"]
}
