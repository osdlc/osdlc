{
  "name": "@osdlc/cli-tool",
  "version": "0.7.0",
  "description": "What a standalone CLI needs before it does anything of its own: an injectable stdout/stderr seam, one exit-code rule, flags declared once so the parser and the help text cannot disagree, and running an installed tool from a development checkout.",
  "license": "MIT OR Apache-2.0",
  "author": "sksizer",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/osdlc/osdlc.git",
    "directory": "packages/ts/cli-tool"
  },
  "homepage": "https://github.com/osdlc/osdlc/tree/main/packages/ts/cli-tool#readme",
  "bugs": "https://github.com/osdlc/osdlc/issues",
  "keywords": [
    "cli",
    "argv",
    "commander",
    "dev-link",
    "launcher"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./devlink": {
      "types": "./dist/devlink/index.d.ts",
      "default": "./dist/devlink/index.js"
    },
    "./define-cli": {
      "types": "./dist/define-cli.d.ts",
      "default": "./dist/define-cli.js"
    },
    "./io": {
      "types": "./dist/io.d.ts",
      "default": "./dist/io.js"
    },
    "./prompt": {
      "types": "./dist/prompt.d.ts",
      "default": "./dist/prompt.js"
    },
    "./exit": {
      "types": "./dist/exit.d.ts",
      "default": "./dist/exit.js"
    },
    "./wrap": {
      "types": "./dist/wrap.d.ts",
      "default": "./dist/wrap.js"
    },
    "./command": {
      "types": "./dist/command/index.d.ts",
      "default": "./dist/command/index.js"
    },
    "./config-command": {
      "types": "./dist/config-command.d.ts",
      "default": "./dist/config-command.js"
    },
    "./trust-command": {
      "types": "./dist/trust-command.d.ts",
      "default": "./dist/trust-command.js"
    },
    "./guide": {
      "types": "./dist/guide.d.ts",
      "default": "./dist/guide.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    },
    "./mcp": {
      "types": "./dist/mcp/index.d.ts",
      "default": "./dist/mcp/index.js"
    },
    "./http": {
      "types": "./dist/http/index.d.ts",
      "default": "./dist/http/index.js"
    }
  },
  "files": [
    "dist/",
    "devlink/README.md",
    "README.md",
    "CHANGELOG.md",
    "LICENSE-MIT",
    "LICENSE-APACHE",
    "SECURITY.md",
    "CONTRIBUTING.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "test": "vitest run",
    "smoke": "node tests/smoke.mjs",
    "coverage": "vitest run --coverage",
    "prepublishOnly": "npm run clean && npm run build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "oxlint .",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.build.json --noEmit"
  },
  "dependencies": {
    "@osdlc/config-layers": "workspace:^",
    "@osdlc/etag-write": "workspace:^",
    "@osdlc/result": "workspace:^",
    "@osdlc/ux": "workspace:^",
    "commander": "^12.1.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@osdlc/command-seam": "workspace:^",
    "@osdlc/prettier-config": "workspace:^",
    "@osdlc/trust-repo": "workspace:^",
    "@osdlc/tsconfig": "workspace:^",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "oxlint": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "zod": "catalog:"
  },
  "peerDependencies": {
    "zod": "^4",
    "@modelcontextprotocol/sdk": "^1.32.0"
  },
  "peerDependenciesMeta": {
    "@modelcontextprotocol/sdk": {
      "optional": true
    }
  }
}
