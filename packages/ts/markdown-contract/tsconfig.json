{
  // Typechecks src/, tests/ and examples/. The build has its own include.
  "extends": "@osdlc/tsconfig/node-lib",
  "compilerOptions": {
    // @osdlc/gfm-table is a workspace sibling that ships a `bun` condition
    // pointing at its source, so a typecheck needs no `dist/` to exist.
    "customConditions": ["bun"],
    // The package ships no TypeScript source, so `exports` has no `bun`
    // condition. Map the package's own name to the source instead, for tsc and
    // (in vitest.config.ts) for the tests, so examples/ and the README blocks
    // run before a build.
    "paths": {
      "@osdlc/markdown-contract": ["./src/index.ts"],
      "@osdlc/markdown-contract/core": ["./src/core/index.ts"],
      "@osdlc/markdown-contract/declarative": ["./src/declarative/index.ts"],
      "@osdlc/markdown-contract/cli": ["./src/cli/index.ts"]
    }
  },
  "include": ["src", "tests", "examples", "vitest.config.ts"]
}
