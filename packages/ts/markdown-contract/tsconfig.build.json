{
  // Emit config for the published dist/; the dev tsconfig.json stays noEmit.
  // The source only, with Node types: the runner, the YAML loaders and the CLI
  // read files. src/core/ imports no Node module (tests/core-entry.test.ts).
  "extends": ["./tsconfig.json", "@osdlc/tsconfig/build"],
  "compilerOptions": {
    "rootDir": "src",
    "types": ["node"],
    // src/ is not published, so a declaration map would point at nothing.
    "declarationMap": false
  },
  "include": ["src"]
}
