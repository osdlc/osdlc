{
  "name": "@osdlc/ref-lease",
  "version": "0.2.6",
  "description": "Compare-and-swap leases on git refs: create, replace and delete a ref at any git remote only if it still holds the sha you read, through git push --force-with-lease, with the payload as canonical JSON in the ref's commit. The payload type is yours.",
  "license": "MIT OR Apache-2.0",
  "author": "sksizer",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/osdlc/osdlc.git",
    "directory": "packages/ts/ref-lease"
  },
  "homepage": "https://github.com/osdlc/osdlc/tree/main/packages/ts/ref-lease#readme",
  "bugs": "https://github.com/osdlc/osdlc/issues",
  "keywords": [
    "git",
    "lease",
    "lock",
    "compare-and-swap",
    "force-with-lease",
    "refs",
    "coordination"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE-MIT",
    "LICENSE-APACHE",
    "SECURITY.md",
    "CONTRIBUTING.md"
  ],
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "test": "vitest run",
    "smoke": "node tests/smoke.mjs",
    "coverage": "vitest run --coverage",
    "prepublishOnly": "npm run clean && npm run build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "oxlint .",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.build.json --noEmit"
  },
  "dependencies": {
    "@osdlc/command-seam": "workspace:^",
    "@osdlc/typed-git": "workspace:^0.15.0"
  },
  "devDependencies": {
    "@osdlc/prettier-config": "workspace:^",
    "@osdlc/tsconfig": "workspace:^",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "oxlint": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
