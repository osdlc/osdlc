{
  "about": "Cases for the push outcome: what a compare-and-swap push's per-ref result means. `flag` is git push --porcelain's status character for the ref; `rejection` is the reason kind @osdlc/typed-git reads from git's reason text (null unless flag is '!'). Every implementation of the protocol maps each case to `expected`.",
  "cases": [
    {
      "name": "create succeeds",
      "op": "create",
      "flag": "*",
      "rejection": null,
      "expected": "ok"
    },
    {
      "name": "replace succeeds (forced update)",
      "op": "replace",
      "flag": "+",
      "rejection": null,
      "expected": "ok"
    },
    {
      "name": "replace succeeds (fast-forward)",
      "op": "replace",
      "flag": " ",
      "rejection": null,
      "expected": "ok"
    },
    {
      "name": "delete succeeds",
      "op": "delete",
      "flag": "-",
      "rejection": null,
      "expected": "ok"
    },
    {
      "name": "create of a ref already at the same sha",
      "op": "create",
      "flag": "=",
      "rejection": null,
      "expected": "cas-failed"
    },
    {
      "name": "replace to the sha the ref already holds",
      "op": "replace",
      "flag": "=",
      "rejection": null,
      "expected": "ok"
    },
    {
      "name": "lease check lost before anything was sent",
      "op": "replace",
      "flag": "!",
      "rejection": "stale",
      "expected": "cas-failed"
    },
    {
      "name": "create of a ref that exists",
      "op": "create",
      "flag": "!",
      "rejection": "stale",
      "expected": "cas-failed"
    },
    {
      "name": "race lost at the authority: ref created first",
      "op": "create",
      "flag": "!",
      "rejection": "already-exists",
      "expected": "cas-failed"
    },
    {
      "name": "race lost at the authority: ref moved or deleted",
      "op": "replace",
      "flag": "!",
      "rejection": "lock-failed",
      "expected": "cas-failed"
    },
    {
      "name": "delete raced by another writer",
      "op": "delete",
      "flag": "!",
      "rejection": "lock-failed",
      "expected": "cas-failed"
    },
    {
      "name": "non-fast-forward",
      "op": "replace",
      "flag": "!",
      "rejection": "non-fast-forward",
      "expected": "cas-failed"
    },
    {
      "name": "remote hook declined",
      "op": "create",
      "flag": "!",
      "rejection": "hook-declined",
      "expected": "git-failed"
    },
    {
      "name": "ref path clash at the authority",
      "op": "create",
      "flag": "!",
      "rejection": "ref-conflict",
      "expected": "git-failed"
    },
    {
      "name": "tag already exists",
      "op": "create",
      "flag": "!",
      "rejection": "tag-exists",
      "expected": "git-failed"
    },
    {
      "name": "another ref of an atomic push failed",
      "op": "replace",
      "flag": "!",
      "rejection": "atomic-failed",
      "expected": "git-failed"
    },
    {
      "name": "anything unrecognised",
      "op": "replace",
      "flag": "!",
      "rejection": "other",
      "expected": "git-failed"
    }
  ]
}
