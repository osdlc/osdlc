{
  "about": "Cases for canonicalJson: the deterministic encoding of a lease payload. Every implementation of the protocol encodes `value` to exactly `expected`.",
  "cases": [
    { "name": "null", "value": null, "expected": "null" },
    { "name": "booleans", "value": [true, false], "expected": "[true,false]" },
    {
      "name": "integers and decimals",
      "value": [0, -1, 1.5, 1e21],
      "expected": "[0,-1,1.5,1e+21]"
    },
    {
      "name": "empty containers",
      "value": { "a": [], "b": {} },
      "expected": "{\"a\":[],\"b\":{}}"
    },
    {
      "name": "keys sorted at every depth",
      "value": { "b": { "z": 1, "a": 2 }, "a": [{ "y": 1, "x": 2 }] },
      "expected": "{\"a\":[{\"x\":2,\"y\":1}],\"b\":{\"a\":2,\"z\":1}}"
    },
    {
      "name": "integer-like keys sorted as strings",
      "value": { "10": 1, "2": 2, "1": 3 },
      "expected": "{\"1\":3,\"10\":1,\"2\":2}"
    },
    {
      "name": "uppercase sorts before lowercase",
      "value": { "b": 1, "B": 2, "a": 3 },
      "expected": "{\"B\":2,\"a\":3,\"b\":1}"
    },
    {
      "name": "non-ASCII kept as UTF-8",
      "value": { "name": "café ✓" },
      "expected": "{\"name\":\"café ✓\"}"
    },
    {
      "name": "control characters and quotes escaped",
      "value": "a\"b\\c\nd\u0001",
      "expected": "\"a\\\"b\\\\c\\nd\\u0001\""
    },
    { "name": "array order kept", "value": [3, 1, 2], "expected": "[3,1,2]" }
  ]
}
