{
  "name": "@osdlc/markdown-tags",
  "version": "0.4.1",
  "description": "Inline #tag lexing for Markdown note bodies in three dialects: Obsidian's rule (the default), a Unicode one that scans code, and an ASCII one. The TypeScript twin of the markdown-tags Rust crate, held to it by a shared conformance suite.",
  "license": "MIT OR Apache-2.0",
  "author": "sksizer",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/osdlc/osdlc.git",
    "directory": "packages/ts/markdown-tags"
  },
  "homepage": "https://github.com/osdlc/osdlc/tree/main/packages/ts/markdown-tags#readme",
  "bugs": "https://github.com/osdlc/osdlc/issues",
  "keywords": [
    "markdown",
    "tags",
    "hashtag",
    "obsidian",
    "unicode",
    "ascii",
    "lexer",
    "typescript"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE-MIT",
    "LICENSE-APACHE",
    "SECURITY.md",
    "CONTRIBUTING.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "bench": "vitest bench --run",
    "smoke": "node tests/smoke.mjs",
    "prepublishOnly": "npm run clean && npm run build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "oxlint .",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.build.json --noEmit"
  },
  "devDependencies": {
    "@osdlc/prettier-config": "workspace:^",
    "@osdlc/tsconfig": "workspace:^",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "oxlint": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "dependencies": {
    "@osdlc/markdown-link": "workspace:^"
  }
}
