{
  "name": "@osdlc/pr-update",
  "version": "0.9.0",
  "description": "Survey and update out-of-date, stacked pull requests against their base: drift measured locally, conflicts predicted with merge-tree, PRs read through the @osdlc/code-host port.",
  "license": "MIT OR Apache-2.0",
  "author": "sksizer",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/osdlc/osdlc.git",
    "directory": "packages/ts/pr-update"
  },
  "homepage": "https://github.com/osdlc/osdlc/tree/main/packages/ts/pr-update#readme",
  "bugs": "https://github.com/osdlc/osdlc/issues",
  "keywords": [
    "pull-request",
    "github",
    "rebase",
    "stacked-prs",
    "cli"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "pr-update": "./bin/pr-update.js"
  },
  "files": [
    "dist/",
    "bin/",
    "docs/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE-MIT",
    "LICENSE-APACHE",
    "SECURITY.md",
    "CONTRIBUTING.md"
  ],
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "build": "cli-tool-stamp-version && tsc -p tsconfig.build.json",
    "stamp-version": "cli-tool-stamp-version",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "test": "vitest run",
    "smoke": "node tests/smoke.mjs",
    "coverage": "vitest run --coverage",
    "prepublishOnly": "npm run clean && npm run build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "oxlint .",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.build.json --noEmit"
  },
  "dependencies": {
    "@osdlc/agent-call": "workspace:^",
    "@osdlc/cli-tool": "workspace:^",
    "@osdlc/code-host": "workspace:^",
    "@osdlc/command-seam": "workspace:^",
    "@osdlc/config-layers": "workspace:^",
    "@osdlc/etag-write": "workspace:^",
    "@osdlc/result": "workspace:^",
    "@osdlc/trust-repo": "workspace:^",
    "@osdlc/typed-git": "workspace:^",
    "yaml": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@osdlc/prettier-config": "workspace:^",
    "@osdlc/tsconfig": "workspace:^",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "oxlint": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
