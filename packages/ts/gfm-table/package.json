{
  "name": "@osdlc/gfm-table",
  "version": "0.1.1",
  "description": "GFM pipe tables as strings and offsets: row splitting with the backslash-escape rule, cell text and escaping, row splices, reading and rendering whole tables, and grid clipboard formats (TSV, CSV, HTML). No dependencies.",
  "license": "MIT OR Apache-2.0",
  "author": "SK Sizer",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/osdlc/osdlc.git",
    "directory": "packages/ts/gfm-table"
  },
  "homepage": "https://github.com/osdlc/osdlc/tree/main/packages/ts/gfm-table#readme",
  "bugs": "https://github.com/osdlc/osdlc/issues",
  "keywords": [
    "markdown",
    "gfm",
    "table",
    "pipe-table",
    "escape",
    "csv",
    "tsv",
    "clipboard",
    "editor",
    "typescript"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist/",
    "src/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE-MIT",
    "LICENSE-APACHE",
    "SECURITY.md",
    "CONTRIBUTING.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "test": "bun test",
    "coverage": "bun test --coverage",
    "smoke": "node tests/smoke.mjs",
    "prepublishOnly": "npm run clean && npm run build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "oxlint .",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.build.json --noEmit"
  },
  "devDependencies": {
    "@osdlc/prettier-config": "workspace:^",
    "@osdlc/tsconfig": "workspace:^",
    "@types/bun": "^1.1.14",
    "@types/node": "^26.1.0",
    "oxlint": "^1.65.0",
    "prettier": "3.9.6",
    "typescript": "~6.0.3"
  }
}
