{
  // Typechecks the sources, test/ and examples/. The build has its own include.
  "extends": "@osdlc/tsconfig/bun-lib",
  "compilerOptions": {
    "lib": ["ES2022"],
    // Resolve `@osdlc/gfm-table` in examples/ to the sources, as bun does.
    "customConditions": ["bun"]
  },
  "include": ["src/**/*.ts", "test/**/*.ts", "examples/**/*.ts"]
}
