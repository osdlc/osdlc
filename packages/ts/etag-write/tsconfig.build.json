{
  // Emit config for the published dist/; the dev tsconfig.json stays noEmit.
  // The source only, and no Bun types, so a Bun global in it fails the build.
  "extends": ["./tsconfig.json", "@osdlc/tsconfig/build"],
  "compilerOptions": {
    "rootDir": ".",
    "types": ["node"]
  },
  "include": ["index.ts"]
}
