{
  "name": "@osdlc/ux",
  "version": "0.1.0",
  "description": "Design tokens as data for web and terminal tools: a CSS custom-property sheet for light and dark, ANSI codes at the terminal's color level, color detection from the environment, and helpers that make untrusted text safe to print and fit it to a width.",
  "license": "MIT OR Apache-2.0",
  "author": "sksizer",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/osdlc/osdlc.git",
    "directory": "packages/ts/ux"
  },
  "homepage": "https://github.com/osdlc/osdlc/tree/main/packages/ts/ux#readme",
  "bugs": "https://github.com/osdlc/osdlc/issues",
  "keywords": [
    "design-tokens",
    "css-variables",
    "dark-mode",
    "ansi",
    "terminal",
    "no-color",
    "force-color",
    "string-width",
    "typescript"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./tokens.css": "./dist/tokens.css"
  },
  "files": [
    "dist/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE-MIT",
    "LICENSE-APACHE",
    "SECURITY.md",
    "CONTRIBUTING.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/build-css.mjs",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "smoke": "node tests/smoke.mjs",
    "prepublishOnly": "npm run clean && npm run build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "oxlint .",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.build.json --noEmit"
  },
  "dependencies": {
    "@osdlc/color": "workspace:^",
    "get-east-asian-width": "^1.7.0"
  },
  "devDependencies": {
    "@osdlc/prettier-config": "workspace:^",
    "@osdlc/tsconfig": "workspace:^",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "oxlint": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
