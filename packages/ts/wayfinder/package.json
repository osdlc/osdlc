{
  "name": "@osdlc/wayfinder",
  "version": "0.11.4",
  "description": "Browse and run every task in a repository from one list: a terminal UI where Enter runs the selected task, a live web view, and JSON for scripts. Tasks, installs, tool trust and git hooks come from @osdlc/system-model.",
  "license": "MIT OR Apache-2.0",
  "author": "sksizer",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/osdlc/osdlc.git",
    "directory": "packages/ts/wayfinder"
  },
  "homepage": "https://github.com/osdlc/osdlc/tree/main/packages/ts/wayfinder#readme",
  "bugs": "https://github.com/osdlc/osdlc/issues",
  "keywords": [
    "task-runner",
    "tui",
    "monorepo",
    "moon",
    "just",
    "npm-scripts",
    "cli"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./schema": {
      "types": "./dist/schema.d.ts",
      "default": "./dist/schema.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "way": "./bin/way.js"
  },
  "files": [
    "dist/",
    "bin/",
    "schema/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE-MIT",
    "LICENSE-APACHE",
    "SECURITY.md",
    "CONTRIBUTING.md"
  ],
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "build": "cli-tool-stamp-version && node scripts/write-document-schemas.ts && tsc -p tsconfig.build.json && node scripts/build-web.mjs",
    "stamp-version": "cli-tool-stamp-version",
    "write:config-schema": "node scripts/write-config-schema.mjs",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "test": "vitest run",
    "test:e2e": "vitest run tests/e2e",
    "smoke": "node tests/smoke.mjs",
    "coverage": "vitest run --coverage",
    "prepublishOnly": "npm run clean && npm run build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "oxlint .",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.build.json --noEmit"
  },
  "dependencies": {
    "@osdlc/cli-tool": "workspace:^",
    "@osdlc/command-seam": "workspace:^",
    "@osdlc/config-layers": "workspace:^",
    "@osdlc/detect-harness": "workspace:^",
    "@osdlc/etag-write": "workspace:^",
    "@osdlc/path-guard": "workspace:^",
    "@osdlc/system-model": "workspace:^",
    "@osdlc/tiered-dirs": "workspace:^",
    "@osdlc/trust-repo": "workspace:^",
    "@osdlc/typed-git": "workspace:^",
    "@osdlc/ux": "workspace:^",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@osdlc/color": "workspace:^",
    "@osdlc/prettier-config": "workspace:^",
    "@osdlc/tsconfig": "workspace:^",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "jsdom": "^26.1.0",
    "oxlint": "catalog:",
    "prettier": "catalog:",
    "rolldown": "^1.2.14",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
