{
  // Emit config for the published dist/; the dev tsconfig.json stays noEmit.
  // The source only, with Node types for TextEncoder and TextDecoder, which
  // the ES2022 lib lacks. Browsers have both; the source imports nothing else.
  "extends": ["./tsconfig.json", "@osdlc/tsconfig/build"],
  "compilerOptions": {
    "rootDir": "src",
    "types": ["node"],
    // src/ is not published, so a declaration map would point at nothing.
    "declarationMap": false
  },
  "include": ["src"]
}
