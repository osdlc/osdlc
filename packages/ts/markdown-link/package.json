{
  "name": "@osdlc/markdown-link",
  "version": "0.0.0",
  "description": "Wikilink parsing that follows documented link-resolution conventions: every [[link]], ![[embed]] and relative markdown link in a note body, with spans, and the code lexer that keeps links in code out. The TypeScript twin of the parsing half of the Rust markdown-link crate, held to it by a shared case file. No dependencies.",
  "license": "MIT OR Apache-2.0",
  "author": "sksizer",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/osdlc/osdlc.git",
    "directory": "packages/ts/markdown-link"
  },
  "homepage": "https://github.com/osdlc/osdlc/tree/main/packages/ts/markdown-link#readme",
  "bugs": "https://github.com/osdlc/osdlc/issues",
  "keywords": [
    "markdown",
    "wikilink",
    "obsidian",
    "links",
    "embed",
    "parser",
    "typescript"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE-MIT",
    "LICENSE-APACHE",
    "SECURITY.md",
    "CONTRIBUTING.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "smoke": "node tests/smoke.mjs",
    "prepublishOnly": "npm run clean && npm run build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "oxlint .",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.build.json --noEmit"
  },
  "devDependencies": {
    "@osdlc/prettier-config": "workspace:^",
    "@osdlc/tsconfig": "workspace:^",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "oxlint": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
