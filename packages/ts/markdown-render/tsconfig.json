{
  "extends": "@osdlc/tsconfig/vue",
  "compilerOptions": {
    // A Vue 3 renderer for ES2022 hosts: the DOM, and JSX left for the bundler.
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "types": ["node"]
  },
  "include": ["src/**/*.ts", "tests/**/*.ts", "examples/**/*.ts", "vitest.config.ts"]
}
