{
  "name": "@osdlc/detect-harness",
  "version": "0.6.0",
  "description": "Find the coding-agent harnesses (Claude Code, Codex, Cursor, opencode, pi, Antigravity) on a machine and in a project, and read what each has configured: plugins, skills, hooks, MCP servers, permissions, instructions and sign-in evidence. Read-only; MCP env and header values, URL credentials and secret-looking MCP args are redacted by default.",
  "license": "MIT OR Apache-2.0",
  "author": "sksizer",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/osdlc/osdlc.git",
    "directory": "packages/ts/detect-harness"
  },
  "homepage": "https://github.com/osdlc/osdlc/tree/main/packages/ts/detect-harness#readme",
  "bugs": "https://github.com/osdlc/osdlc/issues",
  "keywords": [
    "agent",
    "harness",
    "detect",
    "claude-code",
    "codex",
    "cursor",
    "plugin",
    "mcp",
    "hooks",
    "zod"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./locations": {
      "types": "./dist/locations.d.ts",
      "default": "./dist/locations.js"
    },
    "./model": {
      "types": "./dist/model/index.d.ts",
      "default": "./dist/model/index.js"
    }
  },
  "files": [
    "dist/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE-MIT",
    "LICENSE-APACHE",
    "SECURITY.md",
    "CONTRIBUTING.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "smoke": "node tests/smoke.mjs",
    "prepublishOnly": "npm run clean && npm run build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "oxlint .",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.build.json --noEmit"
  },
  "dependencies": {
    "@osdlc/command-seam": "workspace:^",
    "@osdlc/frontmatter-lossless": "workspace:^",
    "@osdlc/path-guard": "workspace:^",
    "@osdlc/tiered-dirs": "workspace:^",
    "smol-toml": "catalog:",
    "yaml": "catalog:"
  },
  "peerDependencies": {
    "zod": "^4"
  },
  "devDependencies": {
    "@osdlc/prettier-config": "workspace:^",
    "@osdlc/tsconfig": "workspace:^",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "oxlint": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "zod": "catalog:"
  }
}
