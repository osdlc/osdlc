{
  // Emit config for the published dist/; the dev tsconfig.json stays noEmit.
  // The source only, and no Node types, so a runtime global in it fails
  // the build: the wrapper must stay plain ES2022. The build script copies the
  // committed wasm/ into dist/wasm/, where the emitted import finds it.
  "extends": ["./tsconfig.json", "@osdlc/tsconfig/build"],
  "compilerOptions": {
    "rootDir": "src",
    "types": [],
    // src/ is not published, so a declaration map would point at nothing.
    "declarationMap": false
  },
  "include": ["src"]
}
