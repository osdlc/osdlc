{
  "name": "@osdlc/yaml-splice",
  "version": "0.1.4",
  "description": "Edit top-level fields of a YAML mapping in place, on bytes: set, remove or rename a field, and every byte outside the edited span stays as it was, including comments, key order, quoting, a BOM and line endings. The yaml-splice Rust crate, built to WebAssembly. Node.js and Bun.",
  "license": "MIT OR Apache-2.0",
  "author": "sksizer",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/osdlc/osdlc.git",
    "directory": "packages/ts/yaml-splice"
  },
  "homepage": "https://github.com/osdlc/osdlc/tree/main/packages/ts/yaml-splice#readme",
  "bugs": "https://github.com/osdlc/osdlc/issues",
  "keywords": [
    "yaml",
    "frontmatter",
    "edit",
    "lossless",
    "comments",
    "byte-identical",
    "wasm",
    "webassembly"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE-MIT",
    "LICENSE-APACHE",
    "SECURITY.md",
    "CONTRIBUTING.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node -e \"const fs=require('node:fs');fs.rmSync('dist/wasm',{recursive:true,force:true});fs.cpSync('wasm','dist/wasm',{recursive:true})\"",
    "build:wasm": "bash ../../rust/yaml-splice-wasm/build.sh",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "test": "bun test && npm run test:node",
    "test:node": "pnpm run build && node --test tests/corpus-node.mjs",
    "coverage": "bun test --coverage",
    "smoke": "node tests/smoke.mjs",
    "prepublishOnly": "npm run clean && npm run build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "oxlint .",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.build.json --noEmit"
  },
  "devDependencies": {
    "@osdlc/prettier-config": "workspace:^",
    "@osdlc/tsconfig": "workspace:^",
    "@types/bun": "^1.1.14",
    "@types/node": "^26.1.0",
    "oxlint": "^1.65.0",
    "prettier": "3.9.6",
    "typescript": "~6.0.3"
  }
}
