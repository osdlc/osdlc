{
  // Typechecks src/, tests/, examples/ and benches/. The build has its own include.
  // Workspace siblings resolve through `exports` to their built `dist/`, so
  // build them before the typecheck.
  "extends": "@osdlc/tsconfig/node-lib",
  "include": ["src", "tests", "examples", "benches", "vitest.config.ts"]
}
