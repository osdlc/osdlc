{
  "name": "@osdlc/agent-seat",
  "version": "0.7.4",
  "description": "Open an interactive coding-agent session (claude, codex, cursor, pi and others) in the terminal app, multiplexer or editor a person already uses: a terminal tab, tmux, WezTerm, cmux, herdr, Orca, otty, VS Code or a JetBrains IDE. One host contract in optional parts, any harness in any host.",
  "license": "MIT OR Apache-2.0",
  "author": "sksizer",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/osdlc/osdlc.git",
    "directory": "packages/ts/agent-seat"
  },
  "homepage": "https://github.com/osdlc/osdlc/tree/main/packages/ts/agent-seat#readme",
  "bugs": "https://github.com/osdlc/osdlc/issues",
  "keywords": [
    "agent",
    "coding-agent",
    "claude",
    "codex",
    "terminal",
    "tmux",
    "wezterm",
    "vscode",
    "jetbrains",
    "session"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE-MIT",
    "LICENSE-APACHE",
    "SECURITY.md",
    "CONTRIBUTING.md"
  ],
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "test": "vitest run",
    "smoke": "node tests/smoke.mjs",
    "coverage": "vitest run --coverage",
    "prepublishOnly": "npm run clean && npm run build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "oxlint .",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.build.json --noEmit"
  },
  "dependencies": {
    "@osdlc/agent-call": "workspace:^",
    "@osdlc/command-seam": "workspace:^",
    "@osdlc/detect-harness": "workspace:^",
    "@osdlc/etag-write": "workspace:^",
    "@osdlc/path-guard": "workspace:^",
    "@osdlc/typed-git": "workspace:^",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@osdlc/prettier-config": "workspace:^",
    "@osdlc/tsconfig": "workspace:^",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "oxlint": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
