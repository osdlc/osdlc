  "license": "MIT OR Apache-2.0",
  "author": "sksizer",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/osdlc/osdlc.git",
    "directory": "packages/corpora/sdlc-starter"
  },
  "homepage": "https://github.com/osdlc/osdlc/tree/main/packages/corpora/sdlc-starter#readme",
  "bugs": "https://github.com/osdlc/osdlc/issues",
  "keywords": [
    "corpus-schema",
    "corpus",
    "sdlc",
    "principles",
    "markdown"
  ],
  "publishConfig": {
    "access": "public"
  },
