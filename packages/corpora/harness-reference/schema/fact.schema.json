{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "const": "Harness Fact"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "tags": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "harness": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "subject": {
      "type": "string",
      "pattern": "^[a-z0-9-]+\\/[a-z0-9-]+$"
    },
    "observations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "value": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          },
          "since": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "until": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "observed": {
            "type": "string",
            "format": "date",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
          },
          "source": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "via": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "locator": {
            "type": "string",
            "minLength": 1
          },
          "checked_version": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "string",
            "enum": ["docs", "source", "help-text", "run", "changelog", "inferred"]
          },
          "note": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": ["value", "since", "until", "observed", "source"],
        "additionalProperties": false
      }
    },
    "open": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "question": {
            "type": "string",
            "minLength": 1
          },
          "observed": {
            "type": "string",
            "format": "date",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
          },
          "source": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          }
        },
        "required": ["question", "observed", "source"],
        "additionalProperties": false
      }
    },
    "sources": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "resource": {
            "type": "string",
            "format": "uri"
          },
          "title": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": ["id", "resource", "title"],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "type",
    "title",
    "description",
    "tags",
    "harness",
    "subject",
    "observations",
    "sources"
  ],
  "additionalProperties": false
}
