{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "enum": ["Harness", "Standard"]
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "tags": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "order": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "resource": {
      "type": "string",
      "format": "uri"
    },
    "vendor": {
      "type": "string",
      "minLength": 1
    },
    "versioning": {
      "type": "string",
      "enum": ["semver", "date", "unknown"]
    },
    "sources": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "resource": {
            "type": "string",
            "format": "uri"
          },
          "title": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": ["id", "resource", "title"],
        "additionalProperties": false
      }
    }
  },
  "required": ["type", "title", "description", "tags", "order", "vendor", "versioning", "sources"],
  "additionalProperties": false
}
