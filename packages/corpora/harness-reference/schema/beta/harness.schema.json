{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1
    },
    "vendor": {
      "type": "string",
      "minLength": 1
    },
    "homepage": {
      "type": "string",
      "format": "uri"
    },
    "docs": {
      "type": "string",
      "format": "uri"
    },
    "repository": {
      "type": "string",
      "format": "uri"
    },
    "license": {
      "type": "string",
      "minLength": 1
    },
    "open_source": {
      "type": "boolean"
    },
    "cli": {
      "type": "string",
      "minLength": 1
    },
    "surfaces": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["cli", "ide", "desktop", "web"]
      }
    },
    "status": {
      "type": "string",
      "enum": ["current", "sunsetting", "retired"]
    },
    "successor": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "fork_of": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "versioning": {
      "type": "string",
      "enum": ["semver", "date", "unknown"]
    },
    "checked": {
      "type": "string",
      "format": "date",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
    },
    "sources": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "format": "uri"
          },
          "title": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": ["url", "title"],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "name",
    "vendor",
    "homepage",
    "docs",
    "open_source",
    "surfaces",
    "status",
    "versioning",
    "checked",
    "sources"
  ],
  "additionalProperties": false
}
