{
  "name": "harness-reference",
  "private": true,
  "type": "module",
  "description": "A versioned, cited record of how coding-agent harnesses differ, as an OKF v0.2 bundle, with its validator and page generator.",
  "license": "MIT OR Apache-2.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "validate": "pnpm run validate:alpha",
    "validate:alpha": "node src/alpha/validate.ts",
    "write-schema": "pnpm run write-schema:alpha",
    "write-schema:alpha": "node src/alpha/validate.ts --write-schema",
    "test": "node --test src/*/*.test.ts",
    "typecheck": "tsc -p tsconfig.json",
    "generate": "node src/alpha/generate.ts",
    "check": "pnpm run validate && pnpm run test && pnpm run typecheck && pnpm run generate"
  },
  "dependencies": {
    "yaml": "2.9.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:"
  }
}
