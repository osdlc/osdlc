{
  "name": "sdlc-packages",
  "private": true,
  "type": "module",
  "description": "Workspace root for the TypeScript libraries published to npm from this repository's packages/ts/ directory.",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "pnpm -r --if-present run typecheck",
    "build": "pnpm -r --if-present run build",
    "test": "pnpm -r --if-present run test",
    "smoke": "pnpm -r --if-present run smoke",
    "lint": "pnpm -r --if-present run lint",
    "format:check": "pnpm -r --if-present run format:check",
    "check:packages": "node scripts/check-packages.ts",
    "check:crates": "node scripts/package-shape-rs.ts",
    "typecheck:scripts": "tsc -p scripts/tsconfig.json",
    "version-packages": "changeset version && pnpm -r --if-present run stamp-version && pnpm --filter @osdlc/wayfinder run build && pnpm --filter @osdlc/wayfinder run write:config-schema"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "catalog:",
    "@changesets/cli": "catalog:",
    "@types/node": "catalog:",
    "@types/semver": "catalog:",
    "oxlint": "catalog:",
    "publint": "catalog:",
    "semver": "catalog:",
    "typescript": "catalog:"
  }
}
