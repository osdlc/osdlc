{
  "name": "sdlc-packages",
  "private": true,
  "description": "Workspace root for the TypeScript libraries published to npm from this repository's packages/ts/ directory.",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "pnpm -r --if-present run typecheck",
    "build": "pnpm -r --if-present run build",
    "test": "pnpm -r --if-present run test",
    "smoke": "pnpm -r --if-present run smoke",
    "lint": "pnpm -r --if-present run lint",
    "format:check": "pnpm -r --if-present run format:check",
    "check:packages": "node scripts/check-packages.mjs"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "catalog:",
    "@changesets/cli": "catalog:",
    "oxlint": "catalog:",
    "publint": "catalog:",
    "semver": "catalog:"
  }
}
