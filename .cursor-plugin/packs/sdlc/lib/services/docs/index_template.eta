<%
/*
 * Eta template for docs/index.md — owns ALL table layout for the SDLC index.
 *
 * Fed plain data structures by generate.ts (it.products, it.drivers,
 * it.milestones, it.features, it.principles, it.standards, it.adrs,
 * it.capabilities, plus the Appendix sections it.glossary and
 * it.references — the same data the standalone glossary/references
 * artifacts render). Each section carries `active` rows and `followup` rows
 * (Emerging / obsoleted, with a state). A follow-up table renders only when
 * its bucket is non-empty.
 *
 * Helpers below build a markdown table from a header row and a list of cell
 * arrays, so column layout lives in exactly one place per shape.
 *
 * The leading frontmatter block stamps this file as the corpus's OKF
 * bundle-root `index.md` ([[M-LBU2]] / [[T-IZ3L]]): `okf_version: "0.2"`
 * naming the OKF spec revision this bundle conforms to. Per OKF spec §8/§12 a
 * bundle-root index carries ONLY that key — no `type`, since an index is not a
 * concept document.
 */
function pipeRow(cells) {
  return "| " + cells.map((c) => String(c ?? "")).join(" | ") + " |";
}
function table(headers, rows) {
  const lines = [pipeRow(headers), pipeRow(headers.map(() => "---"))];
  for (const r of rows) lines.push(pipeRow(r));
  return lines.join("\n");
}
/* Active table from `section.active` (positional cells). */
function activeTable(headers, section) {
  return table(headers, section.active.map((r) => r.cells));
}
/* Follow-up table: the section's cells plus a trailing State column. */
function followupTable(headers, section) {
  const withState = headers.concat(["State"]);
  return table(withState, section.followup.map((r) => r.cells.concat([r.state])));
}
%>
---
okf_version: "0.2"
---

# Ontological

> The single front-door for Ontological. The **Narrative** lives in the prose
> docs — [[N-41AZ-vision]] (the why, the end state, and the plan), [[PR-0001-sdlc]] (what it is and how it's
> designed), [[D-VSLI-distributed-work-runner-architecture]] (the architecture). The
> **Reference** below is generated from the entities on disk by the
> `docs` skill. **Do not hand-edit** — edit the source entity and
> regenerate.

---

# Reference

> Generated by the `docs` skill from entities on disk. Summary cells
> transclude each entity's `^summary` block, so they never drift. Each
> section splits into an **Active** table (in effect today) and, when
> non-empty, a follow-up **Emerging / obsoleted** table.

