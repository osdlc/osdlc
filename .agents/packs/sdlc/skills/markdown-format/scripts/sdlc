#!/bin/sh
# sdlc — per-skill shim. GENERATED by agent-pants; do not edit.
#
# Walks up from this script's own directory looking for cli/sdlc — the
# plugin-level launcher asset — and runs it. Falls back to `sdlc` on PATH
# when no such ancestor is found (a skill copied out of the plugin, or a
# harness that doesn't lay out cli/sdlc where this build put it).
#
# This skill's own body calls this shim directly: its harness has no
# `${CLAUDE_PLUGIN_ROOT}` substitution of its own, so every
# `${CLAUDE_PLUGIN_ROOT}/cli/sdlc` call site the vault wrote was
# rewritten to this skill-relative path at render time. Claude Code does
# substitute that token, so a Claude skill never gets this file at all.
set -eu

dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
while [ "$dir" != "/" ]; do
if [ -x "$dir/cli/sdlc" ]; then
exec "$dir/cli/sdlc" "$@"
fi
dir=$(dirname -- "$dir")
done

exec sdlc "$@"
