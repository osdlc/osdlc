#!/usr/bin/env bash
# sdlc — launcher. GENERATED by @sksizer/cli-tool/devlink from this tool's spec;
# regenerate rather than edit (the drift test compares the two).
#
# Picks which checkout answers, in this order:
#   SDLC_HOME env → checkout above $PWD → linked checkout → local.
# Explicit env always applies. The cwd and link layers are off when a
# suppressor is set (CLAUDE_PLUGIN_ROOT) — a harness that invokes this
# launcher must never have its code silently swapped — and the cwd layer
# alone is off under SDLC_CWD_DEV=0. `sdlc dev` manages the link.
#
# Says which entry runs, and why, on stderr before anything else, so with
# four layers a person can tell which code is answering. SDLC_QUIET=1 silences it.
set -euo pipefail

# Resolve THIS file through any symlink chain:
# `here` must be the directory the real launcher sits in.
src="${BASH_SOURCE[0]}"
while [ -L "$src" ]; do
  dir="$(cd -P "$(dirname "$src")" && pwd)"
  src="$(readlink "$src")"
  case "$src" in /*) ;; *) src="$dir/$src" ;; esac
done
here="$(cd -P "$(dirname "$src")" && pwd)"
self="$(cd -P "$here/../../.." && pwd)"

announce() {
  [ "${SDLC_QUIET:-0}" = "1" ] || echo "sdlc: running $1 ($2)" >&2
}

is_checkout() {
  [ -n "$1" ] && [ -d "$1" ] && [ -f "$1/solutions/ontological/cli/sdlc.ts" ]
}

# Source under Bun resolves imports from the checkout's own node_modules; a fresh
# worktree has none, and a fast-forward that adds a dependency leaves it one
# package short. Either way the first import would fail far from the cause, so
# name the checkout and the fix up front. $1 is the checkout, $2 the entry; the
# packages checked are the `dependencies` of every package.json from the entry up
# to the checkout, each looked up the
# way Bun walks node_modules, stopping at the checkout (or at a filesystem
# root, so a non-ancestor checkout path cannot loop).
need_deps() {
  if [ -f "$1/package.json" ] && [ ! -d "$1/node_modules" ]; then
    echo "sdlc: $1 has no node_modules. Run 'bun install' there." >&2
    exit 1
  fi
  local pkg dep d up
  pkg="$(dirname "$2")"
  while :; do
    if [ -f "$pkg/package.json" ]; then
      for dep in $(awk 'function emit(s,  n,a,i){n=split(s,a,","); for(i=1;i<=n;i++) if(match(a[i],/"[^"]+"/)) print substr(a[i],RSTART+1,RLENGTH-2)} /"dependencies"[[:space:]]*:/ && !f {s=$0; sub(/^.*"dependencies"[[:space:]]*:[[:space:]]*[{]/,"",s); if((i=index(s,"}"))>0){emit(substr(s,1,i-1)); exit} emit(s); f=1; next} f {if((i=index($0,"}"))>0){emit(substr($0,1,i-1)); exit} emit($0)}' "$pkg/package.json"); do
        d="$pkg"
        while :; do
          [ -e "$d/node_modules/$dep" ] && continue 2
          [ "$d" = "$1" ] && break
          up="$(dirname "$d")"
          [ "$up" = "$d" ] && break
          d="$up"
        done
        echo "sdlc: $1 is missing package '$dep'. Run 'bun install' there." >&2
        exit 1
      done
    fi
    [ "$pkg" = "$1" ] && break
    up="$(dirname "$pkg")"
    [ "$up" = "$pkg" ] && break
    pkg="$up"
  done
}

home=""
via=""
layer="local"

# ── env: SDLC_HOME ───────────────────────────────────────────────
if is_checkout "${SDLC_HOME:-}"; then
  home="${SDLC_HOME}"; via="SDLC_HOME"; layer="env"
fi

# ── cwd: a checkout above $PWD ──────────────────────────────────────────
if [ -z "$home" ] && [ -z "${CLAUDE_PLUGIN_ROOT+x}" ] && [ "${SDLC_CWD_DEV:-1}" != "0" ]; then
  probe="$PWD"
  while :; do
    if is_checkout "$probe"; then home="$probe"; via="dev checkout above cwd"; layer="cwd"; break; fi
    parent="$(dirname "$probe")"
    [ "$parent" = "$probe" ] && break
    probe="$parent"
  done
fi

# ── link: `<config>/sdlc/home`, written by `sdlc dev link|use` ─────
# Mirrors @osdlc/tiered-dirs standalone("sdlc").config(): the launcher runs
# before a runtime exists, so it cannot call the SDK.
if [ -z "$home" ] && [ -z "${CLAUDE_PLUGIN_ROOT+x}" ]; then
  case "$(uname -s)" in
    Darwin) cfg="$HOME/Library/Application Support/sdlc" ;;
    *)      cfg="${XDG_CONFIG_HOME:-$HOME/.config}/sdlc" ;;
  esac
  linked="$(cat "$cfg/home" 2>/dev/null || true)"
  if is_checkout "$linked"; then home="$linked"; via="linked checkout: $cfg/home"; layer="link"; fi
fi

# ── a selected checkout other than this one runs its source under Bun ──
if [ -n "$home" ]; then
  home_real="$(cd -P "$home" && pwd)"
  if [ "$home_real" != "$self" ]; then
    if ! command -v bun >/dev/null 2>&1; then
      echo "sdlc: the selected checkout ($home_real) runs from source and needs bun on PATH." >&2
      echo "      Install Bun (https://bun.sh), or run 'sdlc dev off' to use the local install." >&2
      exit 1
    fi
    need_deps "$home_real" "$home_real/solutions/ontological/cli/sdlc.ts"
    announce "$home_real/solutions/ontological/cli/sdlc.ts" "$via"
    export SDLC_LAUNCH_LAYER="$layer"
    exec bun run "$home_real/solutions/ontological/cli/sdlc.ts" "$@"
  fi
  # The selected checkout is this launcher's own: it reads as the install, not as a dev selection.
  layer="local"
fi

# ── local: what sits beside this launcher ───────────────────────────────
# A dev checkout (installed, with bun) runs its source, so a committed
# built entry never shadows the code being edited. Anything else — an
# install, or an uninstalled clone — runs the built entry.
dev_checkout=0
if is_checkout "$self" && [ -d "$self/node_modules" ] && command -v bun >/dev/null 2>&1; then dev_checkout=1; fi
if [ "$dev_checkout" = "0" ] && [ -f "$here/sdlc.js" ]; then
  if ! command -v node >/dev/null 2>&1; then
    echo "sdlc: the built entry 'sdlc.js' is present but 'node' is not on PATH." >&2
    exit 1
  fi
  announce "$here/sdlc.js" "local, node"
  export SDLC_LAUNCH_LAYER="$layer"
  exec node "$here/sdlc.js" "$@"
fi
if ! command -v bun >/dev/null 2>&1; then
  echo "sdlc: the source entry needs bun on PATH. Install Bun (https://bun.sh)." >&2
  exit 1
fi
need_deps "$self" "$self/solutions/ontological/cli/sdlc.ts"
announce "$self/solutions/ontological/cli/sdlc.ts" "local, bun"
export SDLC_LAUNCH_LAYER="$layer"
exec bun run "$self/solutions/ontological/cli/sdlc.ts" "$@"
