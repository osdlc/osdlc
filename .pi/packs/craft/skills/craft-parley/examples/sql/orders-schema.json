  "questions": [
    {
      "id": "q-refund-source",
      "prompt": "`orders.total_cents` drifts from line items after refunds. Where should the canonical total live?",
      "kind": "single",
      "about": "orders.total_cents",
      "recommended": "view",
      "options": [
        {
          "id": "view",
          "label": "Derive it in a view over order_items plus refunds",
          "detail": "No write path to keep in sync; a little slower on the account page."
        },
        {
          "id": "trigger",
          "label": "Keep the column, maintain it with a trigger on refunds",
          "detail": "Fast reads; one more trigger to reason about."
        },
        {
          "id": "leave",
          "label": "Leave as is and document the drift",
          "detail": "Zero work now; reporting keeps special-casing it."
        }
      ]
    }
