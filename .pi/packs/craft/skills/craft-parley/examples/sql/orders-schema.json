          "id": "orders",
          "name": "orders",
          "purpose": "A checkout that reached payment. Status moves `pending → paid → shipped → delivered`, or to `cancelled` from pending or paid.",
          "rows": 3100000,
          "primaryKey": ["id"],
          "columns": [
            {
              "id": "orders.id",
